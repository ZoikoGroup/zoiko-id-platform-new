{
  "components": {
    "schemas": {
      "DirectorySyncActionIn": {
        "additionalProperties": false,
        "properties": {
          "approval_request_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Request Id"
          }
        },
        "title": "DirectorySyncActionIn",
        "type": "object"
      },
      "DirectorySyncCredentialIn": {
        "additionalProperties": false,
        "properties": {
          "approval_request_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Request Id"
          },
          "secret": {
            "format": "password",
            "maxLength": 512,
            "minLength": 1,
            "title": "Secret",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "secret"
        ],
        "title": "DirectorySyncCredentialIn",
        "type": "object"
      },
      "DirectorySyncIn": {
        "additionalProperties": false,
        "properties": {
          "approval_request_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Request Id"
          },
          "display_name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "interval_seconds": {
            "default": 3600,
            "maximum": 86400.0,
            "minimum": 300.0,
            "title": "Interval Seconds",
            "type": "integer"
          },
          "provider": {
            "const": "AUTH0",
            "title": "Provider",
            "type": "string"
          },
          "secret": {
            "format": "password",
            "maxLength": 512,
            "minLength": 1,
            "title": "Secret",
            "type": "string",
            "writeOnly": true
          },
          "settings": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 8,
            "title": "Settings",
            "type": "object"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "provider",
          "display_name",
          "settings",
          "secret"
        ],
        "title": "DirectorySyncIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LifecycleBody": {
        "additionalProperties": false,
        "properties": {
          "effective_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective At"
          },
          "event": {
            "$ref": "#/components/schemas/LifecycleEvent"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "event"
        ],
        "title": "LifecycleBody",
        "type": "object"
      },
      "LifecycleEvent": {
        "enum": [
          "JOINER",
          "MOVER",
          "LEAVER",
          "LEAVE_START",
          "LEAVE_END"
        ],
        "title": "LifecycleEvent",
        "type": "string"
      },
      "ResumeIn": {
        "additionalProperties": false,
        "properties": {
          "approval_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Request Id"
          }
        },
        "title": "ResumeIn",
        "type": "object"
      },
      "SourceIn": {
        "additionalProperties": false,
        "description": "Exactly one way to name the connector's OAuth client: its public `jwks` (the platform creates the\nclient) or the `client_id` of one that already exists in this tenant.",
        "properties": {
          "approval_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Request Id"
          },
          "client_id": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "display_name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "jwks": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jwks"
          }
        },
        "required": [
          "display_name"
        ],
        "title": "SourceIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
