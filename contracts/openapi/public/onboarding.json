{
  "components": {
    "schemas": {
      "ApprovalBody": {
        "additionalProperties": false,
        "properties": {
          "approval_request_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Request Id"
          }
        },
        "title": "ApprovalBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OrganizationBody": {
        "additionalProperties": false,
        "properties": {
          "identifier": {
            "maxLength": 20,
            "minLength": 6,
            "title": "Identifier",
            "type": "string"
          },
          "lei": {
            "anyOf": [
              {
                "maxLength": 20,
                "minLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lei"
          },
          "namespace": {
            "pattern": "^(GB-COH)$",
            "title": "Namespace",
            "type": "string"
          }
        },
        "required": [
          "namespace",
          "identifier"
        ],
        "title": "OrganizationBody",
        "type": "object"
      },
      "RollbackBody": {
        "additionalProperties": false,
        "properties": {
          "reason_code": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "title": "Reason Code",
            "type": "string"
          }
        },
        "required": [
          "reason_code"
        ],
        "title": "RollbackBody",
        "type": "object"
      },
      "StageBody": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "scope": {
            "additionalProperties": true,
            "title": "Scope",
            "type": "object"
          }
        },
        "required": [
          "name",
          "scope"
        ],
        "title": "StageBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "zid_platform__modules__onboarding__api__onboarding__PlanBody": {
        "additionalProperties": false,
        "properties": {
          "acceptance_suite": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Acceptance Suite",
            "type": "array"
          },
          "cutover_windows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "maxItems": 20,
            "title": "Cutover Windows",
            "type": "array"
          },
          "data_migration": {
            "default": "NONE",
            "maxLength": 500,
            "title": "Data Migration",
            "type": "string"
          },
          "exit_criteria": {
            "additionalProperties": true,
            "title": "Exit Criteria",
            "type": "object"
          },
          "rollback_triggers": {
            "additionalProperties": true,
            "title": "Rollback Triggers",
            "type": "object"
          },
          "scope": {
            "additionalProperties": true,
            "title": "Scope",
            "type": "object"
          },
          "support": {
            "additionalProperties": true,
            "title": "Support",
            "type": "object"
          },
          "target_mode": {
            "pattern": "^O[0-3]$",
            "title": "Target Mode",
            "type": "string"
          }
        },
        "required": [
          "target_mode"
        ],
        "title": "PlanBody",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Zoiko iD Tenant Onboarding API (organization gate, gates, plans, shadow, pilot, rollback)",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/onboarding/connection": {
      "get": {
        "description": "What a person needs to connect an application, in one read: where to send decisions and how far shadow is.\n\n`shadow` is present while the company is in SHADOW or PILOT: the decisions seen so far against what the plan needs,\neach as a plain ratio, and `ready` when every shadow gate passes. Nothing here is a secret.",
        "operationId": "connection_progress_v1_onboarding_connection_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Connection Progress V1 Onboarding Connection Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Connection Progress",
        "tags": [
          "onboarding"
        ]
      }
    },
