        "enum": [
          "PENDING",
          "ACTIVE",
          "SUSPENDED",
          "DISABLED",
          "SUPERSEDED",
          "ERASED"
        ],
        "title": "PrincipalStatus",
        "type": "string"
      },
      "PrincipalType": {
        "enum": [
          "HUMAN",
          "ORGANIZATION",
          "ORG_UNIT",
          "DEVICE",
          "APPLICATION",
          "SERVICE",
          "WORKLOAD",
          "AI_AGENT",
