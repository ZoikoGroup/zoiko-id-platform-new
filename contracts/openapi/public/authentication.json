              },
              {
                "type": "null"
              }
            ],
            "title": "User Name"
          }
        },
        "required": [
          "client_id"
        ],
        "title": "RegistrationOptionsIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifyIn": {
        "additionalProperties": false,
        "properties": {
          "credential": {
            "additionalProperties": true,
            "title": "Credential",
            "type": "object"
          }
        },
        "required": [
          "credential"
        ],
        "title": "VerifyIn",
        "type": "object"
      },
      "zid_platform__modules__authentication__api__recovery__StartIn": {
        "additionalProperties": false,
        "properties": {
          "client_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Client Id",
            "type": "string"
          },
          "recovery_code": {
            "maxLength": 32,
            "minLength": 16,
            "title": "Recovery Code",
            "type": "string"
          }
        },
        "required": [
          "client_id",
          "recovery_code"
        ],
        "title": "StartIn",
        "type": "object"
      },
      "zid_platform__modules__authentication__api__webauthn__CredentialIn": {
        "additionalProperties": false,
        "properties": {
          "client_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Client Id",
            "type": "string"
          },
          "credential": {
            "additionalProperties": true,
            "title": "Credential",
            "type": "object"
          },
          "label": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          }
        },
        "required": [
          "client_id",
          "credential"
        ],
        "title": "CredentialIn",
        "type": "object"
      }
    }
