        "properties": {
          "principal_id": {
            "format": "uuid",
            "title": "Principal Id",
            "type": "string"
          }
        },
        "required": [
          "principal_id"
        ],
        "title": "AssistIn",
        "type": "object"
      },
      "ChallengeIn": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "pattern": "^[a-z0-9-]{3,120}$",
            "title": "Action",
            "type": "string"
          },
          "change": {
            "additionalProperties": true,
            "title": "Change",
            "type": "object"
          },
          "critical": {
            "default": false,
            "title": "Critical",
            "type": "boolean"
          },
          "resource": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Resource",
            "type": "string"
          }
        },
        "required": [
          "action",
          "resource"
        ],
        "title": "ChallengeIn",
        "type": "object"
      },
      "ClientRef": {
        "additionalProperties": false,
        "properties": {
          "client_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Client Id",
            "type": "string"
          }
        },
        "required": [
          "client_id"
        ],
        "title": "ClientRef",
        "type": "object"
      },
      "ContinueIn": {
        "additionalProperties": false,
        "properties": {
          "approval_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Request Id"
          },
          "client_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Client Id",
            "type": "string"
          },
          "recovery_handle": {
            "maxLength": 128,
            "minLength": 16,
            "title": "Recovery Handle",
            "type": "string"
          }
        },
        "required": [
          "client_id",
          "recovery_handle"
        ],
        "title": "ContinueIn",
        "type": "object"
      },
      "DenyIn": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "DenyIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LiftIn": {
        "additionalProperties": false,
        "properties": {
          "approval_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Request Id"
          }
        },
        "title": "LiftIn",
        "type": "object"
      },
      "LockboxIn": {
        "additionalProperties": false,
        "properties": {
          "approval_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Request Id"
          },
          "approvers": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 5,
            "minItems": 2,
            "title": "Approvers",
            "type": "array"
          },
