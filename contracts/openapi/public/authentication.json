            "default": 168,
            "maximum": 720.0,
            "minimum": 168.0,
            "title": "Cooling Off Hours",
            "type": "integer"
          },
          "k": {
            "maximum": 5.0,
            "minimum": 2.0,
            "title": "K",
            "type": "integer"
          }
        },
        "required": [
          "approvers",
          "k"
        ],
        "title": "LockboxIn",
        "type": "object"
      },
