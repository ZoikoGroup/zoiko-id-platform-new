{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OverrideIn": {
        "additionalProperties": false,
        "properties": {
          "approval_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Request Id"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 3,
            "title": "Reason",
            "type": "string"
          },
          "state": {
            "enum": [
              "TRUSTED",
              "ELEVATED_RISK",
              "STEP_UP_REQUIRED",
              "REAUTH_REQUIRED",
              "RESTRICTED"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "reason"
        ],
        "title": "OverrideIn",
        "type": "object"
      },
      "PollIn": {
        "properties": {
          "ack": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Ack",
            "type": "array"
          },
          "maxEvents": {
            "default": 10,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Maxevents",
            "type": "integer"
          },
          "returnImmediately": {
            "default": true,
            "title": "Returnimmediately",
            "type": "boolean"
          }
        },
        "title": "PollIn",
        "type": "object"
      },
      "SignalIn": {
        "additionalProperties": false,
        "properties": {
          "effective_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective At"
          },
          "event_type": {
            "title": "Event Type",
            "type": "string"
          },
          "source_event_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Source Event Id",
            "type": "string"
          },
          "subject_id": {
            "format": "uuid",
            "title": "Subject Id",
            "type": "string"
          },
          "subject_type": {
            "enum": [
              "PRINCIPAL",
              "SESSION",
              "CREDENTIAL"
            ],
            "title": "Subject Type",
            "type": "string"
          }
        },
        "required": [
          "event_type",
          "subject_type",
          "subject_id",
          "source_event_id"
        ],
        "title": "SignalIn",
        "type": "object"
      },
      "StreamIn": {
        "additionalProperties": false,
        "properties": {
          "algorithms": {
            "items": {
              "enum": [
                "ES256",
                "Ed25519",
                "RS256",
                "PS256"
              ],
              "type": "string"
            },
            "title": "Algorithms",
            "type": "array"
          },
          "audience": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Audience",
            "type": "string"
          },
          "direction": {
            "enum": [
              "RECEIVER",
              "TRANSMITTER"
            ],
            "title": "Direction",
            "type": "string"
          },
          "events": {
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "title": "Events",
            "type": "array"
          },
          "federation_issuer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Federation Issuer"
          },
          "issuer": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issuer"
          },
          "jwks": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jwks"
          },
          "receiver_client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Receiver Client Id"
          },
          "source_trust": {
            "default": "TRUSTED",
            "enum": [
              "INFORMATIONAL",
              "TRUSTED",
              "AUTHORITATIVE"
            ],
            "title": "Source Trust",
            "type": "string"
          },
          "subject_formats": {
            "items": {
              "enum": [
                "iss_sub",
                "opaque"
              ],
              "type": "string"
            },
            "title": "Subject Formats",
            "type": "array"
          }
        },
        "required": [
          "direction",
          "audience",
          "events"
        ],
        "title": "StreamIn",
        "type": "object"
      },
      "SubjectIn": {
        "additionalProperties": false,
        "properties": {
          "opaque_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Opaque Id",
            "type": "string"
          },
          "principal_id": {
            "format": "uuid",
            "title": "Principal Id",
            "type": "string"
          }
        },
        "required": [
          "opaque_id",
          "principal_id"
        ],
        "title": "SubjectIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
