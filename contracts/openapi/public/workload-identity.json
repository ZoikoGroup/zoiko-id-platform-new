{
  "components": {
    "schemas": {
      "BindingBody": {
        "additionalProperties": false,
        "properties": {
          "agent_principal_id": {
            "maxLength": 36,
            "minLength": 36,
            "title": "Agent Principal Id",
            "type": "string"
          },
          "artifact_digest": {
            "pattern": "^sha-?256:[0-9a-f]{64}$",
            "title": "Artifact Digest",
            "type": "string"
          },
          "attestation_required": {
            "default": 0,
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Attestation Required",
            "type": "integer"
          },
          "blueprint_version": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Blueprint Version",
            "type": "string"
          },
          "environment_id": {
            "pattern": "^[a-z0-9-]{1,64}$",
            "title": "Environment Id",
            "type": "string"
          },
          "spiffe_id": {
            "maxLength": 2048,
            "minLength": 10,
            "title": "Spiffe Id",
            "type": "string"
          },
          "valid_to": {
            "format": "date-time",
            "title": "Valid To",
            "type": "string"
          }
        },
        "required": [
          "agent_principal_id",
          "spiffe_id",
          "blueprint_version",
          "artifact_digest",
          "environment_id",
          "valid_to"
        ],
        "title": "BindingBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RevokeBody": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "title": "Reason",
            "type": "string"
          },
          "spiffe_id": {
            "maxLength": 2048,
            "minLength": 10,
            "title": "Spiffe Id",
            "type": "string"
          }
        },
        "required": [
          "spiffe_id",
          "reason"
        ],
        "title": "RevokeBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkloadTokenBody": {
        "additionalProperties": false,
        "properties": {
          "artifact_digest": {
            "pattern": "^sha-?256:[0-9a-f]{64}$",
            "title": "Artifact Digest",
            "type": "string"
          },
          "attestation": {
            "default": 0,
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Attestation",
            "type": "integer"
          },
          "environment_id": {
            "pattern": "^[a-z0-9-]{1,64}$",
            "title": "Environment Id",
            "type": "string"
          }
        },
        "required": [
          "environment_id",
          "artifact_digest"
        ],
        "title": "WorkloadTokenBody",
        "type": "object"
      },
      "zid_platform__modules__machine__api__workloads__QuarantineBody": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "QuarantineBody",
        "type": "object"
      }
    }
  },
  "info": {
