{
  "components": {
    "schemas": {
      "AnnotateBody": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "pattern": "^(ANNOTATION|CORRECTION|INVALIDATION|SUPERSESSION)$",
            "title": "Kind",
            "type": "string"
          },
          "note_commitment": {
            "anyOf": [
              {
                "pattern": "^sha-(256|384|512):[0-9a-f]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note Commitment"
          },
          "reason_code": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "title": "Reason Code",
            "type": "string"
          },
          "superseded_by": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Superseded By"
          }
        },
        "required": [
          "kind",
          "reason_code"
        ],
        "title": "AnnotateBody",
        "type": "object"
      },
      "CaseBody": {
        "additionalProperties": false,
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "kind": {
            "pattern": "^(INVESTIGATION|AUDIT|LEGAL|INCIDENT|DATA_RIGHTS)$",
            "title": "Kind",
            "type": "string"
          },
          "legal_basis": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Legal Basis"
          },
          "purpose": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Purpose",
            "type": "string"
          },
          "reference": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Reference",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "purpose",
          "reference",
          "expires_at"
        ],
        "title": "CaseBody",
        "type": "object"
      },
      "CaseItemBody": {
        "additionalProperties": false,
        "properties": {
          "evidence_item_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Evidence Item Id",
            "type": "string"
          },
          "purpose": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Purpose",
            "type": "string"
          }
        },
        "required": [
          "evidence_item_id",
          "purpose"
        ],
        "title": "CaseItemBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HoldBody": {
        "additionalProperties": false,
        "properties": {
          "approval_request_id": {
            "format": "uuid",
            "title": "Approval Request Id",
            "type": "string"
          },
          "basis": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Basis",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "object_types": {
            "items": {
              "pattern": "^[a-z][a-z0-9_.]{0,63}$",
              "type": "string"
            },
            "maxItems": 50,
            "title": "Object Types",
            "type": "array"
          },
          "reference": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Reference",
            "type": "string"
          },
          "review_at": {
            "format": "date-time",
            "title": "Review At",
            "type": "string"
          },
          "subject_principal_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 1000,
            "title": "Subject Principal Ids",
            "type": "array"
          }
        },
        "required": [
          "basis",
          "reference",
          "review_at",
          "approval_request_id"
        ],
        "title": "HoldBody",
        "type": "object"
      },
      "PackageBody": {
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Id"
          },
          "case_ref": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Case Ref",
            "type": "string"
          },
          "mode": {
            "pattern": "^(AUDITOR|CUSTOMER_VERIFY|INCIDENT|INTERNAL_REPLAY|REGULATOR_LEGAL)$",
            "title": "Mode",
            "type": "string"
          },
          "purpose": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Purpose",
            "type": "string"
          },
          "receipt_id": {
            "format": "uuid",
            "title": "Receipt Id",
            "type": "string"
          },
          "redact": {
            "items": {
              "pattern": "^[a-z_]{1,64}$",
              "type": "string"
            },
            "maxItems": 40,
            "title": "Redact",
            "type": "array"
          }
        },
        "required": [
          "receipt_id",
          "mode",
          "purpose",
          "case_ref"
        ],
        "title": "PackageBody",
        "type": "object"
      },
      "ReleaseBody": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "maxLength": 500,
            "minLength": 3,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "ReleaseBody",
        "type": "object"
      },
      "ResolveBody": {
        "additionalProperties": false,
        "properties": {
          "case_ref": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Case Ref",
            "type": "string"
          },
          "handle": {
            "pattern": "^ph1\\.[0-9]+\\.[A-Za-z0-9_-]+$",
            "title": "Handle",
            "type": "string"
          },
          "purpose": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Purpose",
            "type": "string"
          }
        },
        "required": [
          "handle",
          "purpose",
          "case_ref"
        ],
        "title": "ResolveBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Zoiko iD Evidence, Audit and Provenance API (receipts, proofs, replay, export, legal holds)",
    "version": "1.0.0"
  },
