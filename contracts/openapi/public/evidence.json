    "/v1/evidence/artifacts/{artifact_type}/{artifact_ref}": {
      "get": {
        "operationId": "get_artifact_v1_evidence_artifacts__artifact_type___artifact_ref__get",
        "parameters": [
          {
            "in": "path",
            "name": "artifact_type",
            "required": true,
            "schema": {
              "pattern": "^[A-Z_]{1,64}$",
              "title": "Artifact Type",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "artifact_ref",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Artifact Ref",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Artifact V1 Evidence Artifacts  Artifact Type   Artifact Ref  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Artifact",
        "tags": [
          "evidence"
        ]
      }
    },
