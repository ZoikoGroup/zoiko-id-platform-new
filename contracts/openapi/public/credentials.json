{
  "components": {
    "schemas": {
      "ConfigurationIn": {
        "additionalProperties": false,
        "properties": {
          "assurance_profile_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assurance Profile Id"
          },
          "credential_type": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Credential Type",
            "type": "string"
          },
          "format": {
            "enum": [
              "SD_JWT_VC",
              "MDOC",
              "VC_JWT"
            ],
            "title": "Format",
            "type": "string"
          },
          "holder_binding_required": {
            "default": true,
            "title": "Holder Binding Required",
            "type": "boolean"
          },
          "issuance_enabled": {
            "default": false,
            "title": "Issuance Enabled",
            "type": "boolean"
          },
          "optional_claims": {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "title": "Optional Claims",
            "type": "array"
          },
          "required_claims": {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Required Claims",
            "type": "array"
          },
          "risk_class": {
            "default": 2,
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Risk Class",
            "type": "integer"
          },
          "status_mandatory": {
            "default": true,
            "title": "Status Mandatory",
            "type": "boolean"
          },
          "status_method": {
            "enum": [
              "TOKEN_STATUS_LIST",
              "BITSTRING_STATUS_LIST",
              "NONE"
            ],
            "title": "Status Method",
            "type": "string"
          }
        },
        "required": [
          "credential_type",
          "format",
          "required_claims",
          "status_method"
        ],
        "title": "ConfigurationIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PresentationIn": {
        "additionalProperties": false,
        "properties": {
          "claims": {
            "items": {
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 1,
            "title": "Claims",
            "type": "array"
          },
          "configuration_id": {
            "format": "uuid",
            "title": "Configuration Id",
            "type": "string"
          },
          "jurisdiction": {
            "pattern": "^[A-Z]{2}$",
            "title": "Jurisdiction",
            "type": "string"
          },
          "purpose": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Purpose",
            "type": "string"
          },
          "response_mode": {
            "default": "direct_post",
            "enum": [
              "direct_post",
              "direct_post.jwt"
            ],
            "title": "Response Mode",
            "type": "string"
          },
          "subject_principal_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject Principal Id"
          }
        },
        "required": [
          "configuration_id",
          "purpose",
          "claims",
          "jurisdiction"
        ],
        "title": "PresentationIn",
        "type": "object"
      },
      "RegistrationIn": {
        "additionalProperties": false,
        "properties": {
          "allowed_attributes": {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Allowed Attributes",
            "type": "array"
          },
          "client_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Client Id",
            "type": "string"
          },
          "purpose": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Purpose",
            "type": "string"
          },
          "retention_days": {
            "default": 0,
            "maximum": 3650.0,
            "minimum": 0.0,
            "title": "Retention Days",
            "type": "integer"
          },
          "valid_to": {
            "format": "date-time",
            "title": "Valid To",
            "type": "string"
          }
        },
        "required": [
          "client_id",
          "purpose",
          "allowed_attributes",
          "valid_to"
        ],
        "title": "RegistrationIn",
        "type": "object"
      },
      "TrustIn": {
        "additionalProperties": false,
        "properties": {
          "algorithms": {
            "items": {
              "enum": [
                "ES256",
                "Ed25519",
                "RS256",
                "PS256"
              ],
              "type": "string"
            },
            "title": "Algorithms",
            "type": "array"
          },
          "credential_types": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Credential Types",
            "type": "array"
          },
          "iaca_certificates": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Iaca Certificates"
          },
          "issuer_identifier": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Issuer Identifier",
            "type": "string"
          },
          "jurisdictions": {
            "items": {
              "type": "string"
            },
            "title": "Jurisdictions",
            "type": "array"
          },
          "jwks": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jwks"
          },
          "trust_anchor_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trust Anchor Id"
          },
          "trust_source": {
            "enum": [
              "PINNED",
              "FEDERATION"
            ],
            "title": "Trust Source",
            "type": "string"
          },
          "valid_to": {
            "format": "date-time",
            "title": "Valid To",
            "type": "string"
          }
        },
        "required": [
          "issuer_identifier",
          "credential_types",
          "trust_source",
          "valid_to"
        ],
        "title": "TrustIn",
        "type": "object"
      },
      "TrustStatusIn": {
        "additionalProperties": false,
        "properties": {
          "issuer_identifier": {
            "title": "Issuer Identifier",
            "type": "string"
          },
          "status": {
            "enum": [
              "SUSPENDED",
              "REVOKED",
              "QUARANTINED",
              "ACTIVE"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "issuer_identifier",
          "status"
        ],
        "title": "TrustStatusIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "zid_platform__modules__credential__api__credentials__CredentialIn": {
        "additionalProperties": false,
        "properties": {
          "credential_configuration_id": {
            "format": "uuid",
            "title": "Credential Configuration Id",
            "type": "string"
