{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ProposalStatus": {
        "enum": [
          "OPEN",
          "ASSIGNED",
          "DISMISSED",
          "HANDED_OFF"
        ],
        "title": "ProposalStatus",
        "type": "string"
      },
      "ReadinessAssignBody": {
        "additionalProperties": false,
        "properties": {
          "assignee": {
            "maxLength": 36,
            "minLength": 36,
            "title": "Assignee",
            "type": "string"
          }
        },
        "required": [
          "assignee"
        ],
        "title": "ReadinessAssignBody",
        "type": "object"
      },
      "ReadinessCreateBody": {
        "additionalProperties": false,
        "properties": {
          "agent_principal_id": {
            "maxLength": 36,
            "minLength": 36,
            "title": "Agent Principal Id",
            "type": "string"
          },
          "display_name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "max_records": {
            "default": 100,
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Max Records",
            "type": "integer"
          },
          "resource_kinds": {
            "items": {
              "type": "string"
            },
            "maxItems": 4,
            "title": "Resource Kinds",
            "type": "array"
          },
          "warning_window_days": {
            "default": 14,
            "maximum": 90.0,
            "minimum": 1.0,
            "title": "Warning Window Days",
            "type": "integer"
          }
        },
        "required": [
          "agent_principal_id",
          "display_name"
        ],
        "title": "ReadinessCreateBody",
        "type": "object"
      },
      "ReadinessDryRunBody": {
        "additionalProperties": false,
        "properties": {
          "fixture": {
            "default": "baseline",
            "maxLength": 64,
            "title": "Fixture",
            "type": "string"
          },
          "policy_version": {
            "default": "daara-policy/1",
            "maxLength": 64,
            "title": "Policy Version",
            "type": "string"
          }
        },
        "title": "ReadinessDryRunBody",
        "type": "object"
      },
      "ReadinessPatchBody": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "expected_revision": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Revision"
          },
          "max_records": {
            "anyOf": [
              {
                "maximum": 500.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Records"
          },
          "resource_kinds": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 4,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resource Kinds"
          },
          "warning_window_days": {
            "anyOf": [
              {
                "maximum": 90.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warning Window Days"
          }
        },
        "title": "ReadinessPatchBody",
        "type": "object"
      },
      "ReadinessPauseBody": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "default": "OPERATOR_DECISION",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
            "title": "Reason",
            "type": "string"
          }
        },
        "title": "ReadinessPauseBody",
        "type": "object"
      },
      "ReadinessRunBody": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "default": "manual",
            "maxLength": 16,
            "title": "Mode",
            "type": "string"
          },
          "purpose": {
            "default": "access_posture_review",
            "maxLength": 64,
            "title": "Purpose",
            "type": "string"
          },
          "resource_selector": {
            "additionalProperties": true,
            "title": "Resource Selector",
            "type": "object"
          }
        },
        "title": "ReadinessRunBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
