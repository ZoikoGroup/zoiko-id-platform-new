{
  "components": {
    "schemas": {
      "ApprovalState": {
        "enum": [
          "PENDING",
          "APPROVED",
          "DENIED",
          "EXPIRED",
          "STALE"
        ],
        "title": "ApprovalState",
        "type": "string"
      },
      "CommitBody": {
        "additionalProperties": false,
        "properties": {
          "execution_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Execution Id"
          },
          "recheck_passed": {
            "title": "Recheck Passed",
            "type": "boolean"
          }
        },
        "required": [
          "recheck_passed"
        ],
        "title": "CommitBody",
        "type": "object"
      },
      "CompositeMode": {
        "enum": [
          "SINGLE",
          "ALL_OF",
          "K_OF_N",
          "ROLE_PAIR",
          "EXTERNAL_CONFIRMATION"
        ],
        "title": "CompositeMode",
        "type": "string"
      },
      "ContinuityMode": {
        "description": "DEC-C2 / CR-001: one enum used everywhere.",
        "enum": [
          "PERSON_BOUND",
          "ROLE_CONTINUOUS",
          "ORGANIZATION_CONTINUOUS",
          "CONTRACT_BOUND"
        ],
        "title": "ContinuityMode",
        "type": "string"
      },
      "DecisionCreate": {
        "additionalProperties": false,
        "description": "`authority_grant_id` and `transaction_context` may be left out for a request that records its action,\nresource and change: the grant is then the caller's own qualifying one and the context is rebuilt from the\nrequest, so approving is one click on a readable summary.",
        "properties": {
          "authority_grant_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authority Grant Id"
          },
          "risk_class": {
            "default": 3,
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Risk Class",
            "type": "integer"
          },
          "transaction_context": {
            "anyOf": [
              {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transaction Context"
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          }
        },
        "required": [
          "verdict"
        ],
        "title": "DecisionCreate",
        "type": "object"
      },
      "Delegation": {
        "additionalProperties": false,
        "properties": {
          "allowed": {
            "default": false,
            "title": "Allowed",
            "type": "boolean"
          },
          "max_depth": {
            "default": 0,
            "maximum": 16.0,
            "minimum": 0.0,
            "title": "Max Depth",
            "type": "integer"
          }
        },
        "title": "Delegation",
        "type": "object"
      },
      "GrantCreate": {
        "additionalProperties": false,
        "properties": {
          "actions": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Actions",
            "type": "array"
          },
          "authority_root_assertion_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authority Root Assertion Id"
          },
          "continuity_mode": {
            "$ref": "#/components/schemas/ContinuityMode",
            "default": "PERSON_BOUND"
          },
          "count_limit": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Count Limit"
          },
          "data_categories": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Categories"
          },
          "data_limit_bytes": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Limit Bytes"
          },
          "delegation": {
            "$ref": "#/components/schemas/Delegation"
          },
          "grant_type": {
            "$ref": "#/components/schemas/GrantType",
            "default": "ROLE_ISSUED"
          },
          "grantee_principal_id": {
            "title": "Grantee Principal Id",
            "type": "string"
          },
          "jurisdictions": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jurisdictions"
          },
          "min_assurance": {
            "default": 0,
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Min Assurance",
            "type": "integer"
          },
          "parent_grant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Grant Id"
          },
          "purposes": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purposes"
          },
          "represented_principal_id": {
            "title": "Represented Principal Id",
            "type": "string"
          },
          "resources": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Resources",
            "type": "array"
          },
          "risk_class": {
            "default": 3,
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Risk Class",
            "type": "integer"
          },
          "tools": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tools"
          },
          "valid_from": {
            "format": "date-time",
            "title": "Valid From",
            "type": "string"
          },
          "valid_to": {
            "format": "date-time",
            "title": "Valid To",
            "type": "string"
          },
          "value_limit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Money"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "grantee_principal_id",
          "represented_principal_id",
          "actions",
          "resources",
          "valid_from",
          "valid_to"
        ],
        "title": "GrantCreate",
        "type": "object"
      },
      "GrantStatus": {
        "enum": [
          "DRAFT",
          "PENDING_APPROVAL",
          "ACTIVE",
          "REVALIDATION_PENDING",
          "SUSPENDED",
          "REVOKED",
          "EXPIRED",
          "SUPERSEDED"
        ],
        "title": "GrantStatus",
        "type": "string"
      },
      "GrantType": {
        "enum": [
          "PERSONAL",
          "ROLE_ISSUED",
          "ORGANIZATION_DIRECT",
          "SERVICE_DELEGATION",
          "AGENT_DELEGATION",
          "EXTERNAL_DELEGATION"
        ],
        "title": "GrantType",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MandateCreate": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 1,
            "title": "Allowed Actions",
            "type": "array"
          },
          "authority_grant_id": {
            "format": "uuid",
            "title": "Authority Grant Id",
            "type": "string"
          },
          "count_limit": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Count Limit"
          },
          "data_limit_bytes": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Limit Bytes"
          },
          "delegation": {
            "$ref": "#/components/schemas/Delegation"
          },
          "executor_principal_id": {
            "format": "uuid",
            "title": "Executor Principal Id",
            "type": "string"
          },
          "jurisdictions": {
            "items": {
              "type": "string"
            },
            "maxItems": 64,
            "title": "Jurisdictions",
            "type": "array"
          },
          "per_transaction_value_limit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ValueAmount"
              },
              {
                "type": "null"
              }
            ]
          },
          "purpose_id": {
            "format": "uuid",
            "title": "Purpose Id",
            "type": "string"
          },
          "resource_scopes": {
            "items": {
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 1,
            "title": "Resource Scopes",
            "type": "array"
          },
          "risk_class": {
            "default": 3,
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Risk Class",
            "type": "integer"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "maxItems": 64,
            "title": "Tools",
            "type": "array"
          },
          "valid_from": {
            "format": "date-time",
            "title": "Valid From",
            "type": "string"
          },
          "valid_to": {
            "format": "date-time",
            "title": "Valid To",
            "type": "string"
          },
          "value_limit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ValueAmount"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "authority_grant_id",
          "executor_principal_id",
          "purpose_id",
          "allowed_actions",
          "resource_scopes",
          "valid_from",
          "valid_to"
        ],
        "title": "MandateCreate",
        "type": "object"
      },
      "MandateStatus": {
        "enum": [
          "PENDING_APPROVAL",
          "ACTIVE",
          "PAUSED",
          "EXHAUSTED",
          "COMPLETED",
          "EXPIRED",
          "REVOKED"
        ],
        "title": "MandateStatus",
        "type": "string"
      },
      "Money": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "title": "Money",
        "type": "object"
      },
      "RequestCreate": {
        "additionalProperties": false,
        "description": "Either the exact `transaction_context`, or the `action`, `resource` and `change` it is made of (the app\nbuilds the context itself, so nobody pastes a string). `summary` says in words what the request is for.",
        "properties": {
          "action": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "change": {
            "default": "",
            "maxLength": 2048,
            "title": "Change",
            "type": "string"
          },
          "k": {
            "default": 1,
            "maximum": 16.0,
            "minimum": 1.0,
            "title": "K",
            "type": "integer"
          },
          "mode": {
            "$ref": "#/components/schemas/CompositeMode",
            "default": "SINGLE"
          },
          "resource": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resource"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Roles",
            "type": "array"
          },
          "subject_ref": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Subject Ref",
            "type": "string"
          },
          "summary": {
            "anyOf": [
              {
                "maxLength": 300,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "transaction_context": {
            "anyOf": [
              {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transaction Context"
          },
          "ttl_seconds": {
            "default": 3600,
            "maximum": 604800.0,
            "minimum": 60.0,
            "title": "Ttl Seconds",
            "type": "integer"
          }
        },
        "required": [
          "subject_ref",
          "roles"
        ],
        "title": "RequestCreate",
        "type": "object"
      },
      "ReserveBody": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "count": {
            "default": 0,
            "minimum": 0.0,
            "title": "Count",
            "type": "integer"
          },
          "data_bytes": {
            "default": 0,
            "minimum": 0.0,
            "title": "Data Bytes",
            "type": "integer"
          },
          "tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool"
          },
          "transaction_context": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Transaction Context",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ValueAmount"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "action",
          "transaction_context"
        ],
        "title": "ReserveBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValueAmount": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "title": "ValueAmount",
        "type": "object"
      },
      "Verdict": {
        "enum": [
          "APPROVE",
          "DENY"
        ],
        "title": "Verdict",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Zoiko iD Authority, Approval and Mandate API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/approval-requests": {
      "get": {
        "operationId": "list_all_v1_approval_requests_get",
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ApprovalState"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List All V1 Approval Requests Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List All",
        "tags": [
          "authority"
        ]
      },
      "post": {
        "operationId": "create_v1_approval_requests_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Create V1 Approval Requests Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create",
        "tags": [
          "authority"
        ]
      }
    },
    "/v1/approval-requests/awaiting-me": {
      "get": {
        "description": "Pending requests the caller did not open, has not decided, and holds authority to decide.",
        "operationId": "awaiting_me_v1_approval_requests_awaiting_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Awaiting Me V1 Approval Requests Awaiting Me Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Awaiting Me",
        "tags": [
          "authority"
        ]
      }
    },
    "/v1/approval-requests/for-change": {
      "get": {
        "description": "The caller's own most recent unexpired request for exactly this change, or null.",
        "operationId": "for_change_v1_approval_requests_for_change_get",
        "parameters": [
          {
            "in": "query",
            "name": "action",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Action",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "resource",
            "required": true,
            "schema": {
              "maxLength": 256,
              "minLength": 1,
              "title": "Resource",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "change",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 2048,
              "title": "Change",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response For Change V1 Approval Requests For Change Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "For Change",
        "tags": [
          "authority"
        ]
      }
    },
    "/v1/approval-requests/{request_id}": {
      "get": {
        "operationId": "read_v1_approval_requests__request_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Request Id",
              "type": "string"
            }
          },
          {
            "in": "query",
