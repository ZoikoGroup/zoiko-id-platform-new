              "minLength": 1,
              "title": "Transaction Context",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Read V1 Approval Requests  Request Id  Get",
