            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Tenant Id"
          }
        },
        "required": [
          "capability",
          "case_ref",
          "reason",
          "resource_scope",
          "duration_minutes"
        ],
        "title": "BreakGlassBody",
        "type": "object"
      },
      "DecisionBody": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "default": "",
            "maxLength": 2000,
            "title": "Reason",
            "type": "string"
          }
        },
        "title": "DecisionBody",
        "type": "object"
      },
      "GrantState": {
        "enum": [
          "REQUESTED",
          "APPROVED",
          "ACTIVE",
          "EXPIRED",
          "REVOKED",
          "DENIED",
          "CANCELLED"
        ],
        "title": "GrantState",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ListView": {
        "enum": [
          "mine",
          "pending",
          "all"
