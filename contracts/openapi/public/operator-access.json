          "notes": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Notes",
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/ReviewOutcome"
          }
        },
        "required": [
          "outcome",
          "notes"
        ],
        "title": "ReviewBody",
        "type": "object"
      },
      "ReviewOutcome": {
        "enum": [
          "JUSTIFIED",
          "UNJUSTIFIED"
        ],
        "title": "ReviewOutcome",
        "type": "string"
      },
      "ReviewState": {
        "enum": [
          "REVIEW_PENDING",
          "REVIEWED"
        ],
        "title": "ReviewState",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
