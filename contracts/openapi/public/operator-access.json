            "type": "string"
          },
          "case_ref": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Case Ref",
            "type": "string"
          },
          "duration_minutes": {
            "maximum": 1440.0,
            "minimum": 1.0,
            "title": "Duration Minutes",
            "type": "integer"
          },
          "reason": {
            "maxLength": 2000,
            "minLength": 8,
            "title": "Reason",
            "type": "string"
          },
          "resource_scope": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Resource Scope",
            "type": "string"
          },
          "target_tenant_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Tenant Id"
          }
        },
        "required": [
          "capability",
          "case_ref",
          "reason",
          "resource_scope",
          "duration_minutes"
        ],
        "title": "AccessBody",
        "type": "object"
      },
      "BreakGlassBody": {
        "additionalProperties": false,
        "properties": {
          "capability": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Capability",
            "type": "string"
          },
          "case_ref": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Case Ref",
            "type": "string"
          },
          "duration_minutes": {
            "maximum": 1440.0,
            "minimum": 1.0,
            "title": "Duration Minutes",
            "type": "integer"
          },
          "reason": {
            "maxLength": 2000,
            "minLength": 20,
            "title": "Reason",
            "type": "string"
          },
          "resource_scope": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Resource Scope",
            "type": "string"
          },
