    "/principals/{principal_id}/assurance": {
      "get": {
        "operationId": "assurance_principals__principal_id__assurance_get",
        "parameters": [
          {
            "in": "path",
            "name": "principal_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Principal Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Assurance Principals  Principal Id  Assurance Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Assurance",
        "tags": [
          "verification"
        ]
      }
    },
