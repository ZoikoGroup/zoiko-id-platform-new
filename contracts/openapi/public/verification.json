{
  "components": {
    "schemas": {
      "AdapterIn": {
        "additionalProperties": false,
        "properties": {
          "adapter_id": {
            "pattern": "^[a-z0-9][a-z0-9_-]{1,62}$",
            "title": "Adapter Id",
            "type": "string"
          },
          "callback_algorithms": {
            "items": {
              "enum": [
                "ES256",
                "Ed25519",
                "RS256",
                "PS256"
              ],
              "type": "string"
            },
            "minItems": 1,
            "title": "Callback Algorithms",
            "type": "array"
          },
          "callback_jwks": {
            "additionalProperties": true,
            "title": "Callback Jwks",
            "type": "object"
          },
          "equivalence_group": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Equivalence Group",
            "type": "string"
          },
          "jurisdictions": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Jurisdictions",
            "type": "array"
          },
          "mapping_version": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Mapping Version",
            "type": "string"
          },
          "provider": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Provider",
            "type": "string"
          },
          "provider_config": {
            "additionalProperties": true,
            "title": "Provider Config",
            "type": "object"
          },
          "provider_kind": {
            "default": "GENERIC",
            "enum": [
              "GENERIC",
              "VERIFF",
              "SUMSUB"
            ],
            "title": "Provider Kind",
            "type": "string"
          },
          "submit_endpoint": {
            "pattern": "^https://",
            "title": "Submit Endpoint",
            "type": "string"
          },
          "supported_evidence": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Supported Evidence",
            "type": "array"
          }
        },
        "required": [
          "adapter_id",
          "provider",
          "mapping_version",
          "submit_endpoint",
          "equivalence_group",
          "supported_evidence",
          "jurisdictions"
        ],
        "title": "AdapterIn",
        "type": "object"
      },
      "BulkStartIn": {
        "additionalProperties": false,
        "properties": {
          "jurisdiction": {
            "pattern": "^[A-Z]{2}$",
            "title": "Jurisdiction",
            "type": "string"
          },
          "profile_id": {
            "format": "uuid",
            "title": "Profile Id",
            "type": "string"
          },
          "purpose": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Purpose",
            "type": "string"
          },
          "required_level": {
            "anyOf": [
              {
                "enum": [
                  "IAL-Z1",
                  "IAL-Z2",
                  "IAL-Z3"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Required Level"
          },
          "subject_principal_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Subject Principal Ids",
            "type": "array"
          }
        },
        "required": [
          "profile_id",
          "subject_principal_ids",
          "purpose",
          "jurisdiction"
        ],
        "title": "BulkStartIn",
        "type": "object"
      },
      "EstimateIn": {
        "additionalProperties": false,
        "properties": {
          "estimated_age": {
            "maximum": 130.0,
            "minimum": 0.0,
            "title": "Estimated Age",
            "type": "number"
          },
          "margin": {
            "maximum": 60.0,
            "minimum": 0.0,
            "title": "Margin",
            "type": "number"
          }
        },
        "required": [
          "estimated_age",
          "margin"
        ],
        "title": "EstimateIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ProfileIn": {
        "additionalProperties": false,
        "properties": {
          "level": {
            "enum": [
              "IAL-Z1",
              "IAL-Z2",
              "IAL-Z3"
            ],
            "title": "Level",
            "type": "string"
          },
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "requirements": {
            "additionalProperties": true,
            "title": "Requirements",
            "type": "object"
          }
        },
        "required": [
          "name",
          "level",
          "requirements"
        ],
        "title": "ProfileIn",
        "type": "object"
      },
      "RelianceIn": {
        "additionalProperties": false,
        "properties": {
          "claims": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Claims",
            "type": "array"
          },
          "jurisdiction": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jurisdiction"
          },
          "purpose": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Purpose",
            "type": "string"
          },
          "required_level": {
            "enum": [
              "IAL-Z1",
              "IAL-Z2",
              "IAL-Z3"
            ],
            "title": "Required Level",
            "type": "string"
          },
          "subject_principal_id": {
            "format": "uuid",
            "title": "Subject Principal Id",
            "type": "string"
          }
        },
        "required": [
          "subject_principal_id",
          "purpose",
          "required_level",
          "claims"
        ],
        "title": "RelianceIn",
        "type": "object"
      },
      "ReviewIn": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "enum": [
              "APPROVE",
              "REJECT",
              "REQUEST_MORE_EVIDENCE",
              "ESCALATE"
            ],
            "title": "Decision",
            "type": "string"
          },
          "reason_codes": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Reason Codes",
            "type": "array"
          }
        },
        "required": [
          "decision",
          "reason_codes"
        ],
        "title": "ReviewIn",
        "type": "object"
      },
      "V2AgeIn": {
        "additionalProperties": false,
        "properties": {
          "birth_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Birth Date"
          },
          "estimate": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EstimateIn"
              },
              {
                "type": "null"
              }
            ]
          },
          "threshold": {
            "title": "Threshold",
            "type": "integer"
          }
        },
        "required": [
          "threshold"
        ],
        "title": "V2AgeIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "zid_platform__modules__verification__api__verification__StartIn": {
        "additionalProperties": false,
        "properties": {
          "jurisdiction": {
            "pattern": "^[A-Z]{2}$",
            "title": "Jurisdiction",
            "type": "string"
          },
          "profile_id": {
            "format": "uuid",
            "title": "Profile Id",
            "type": "string"
          },
          "purpose": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Purpose",
            "type": "string"
          },
          "required_level": {
            "anyOf": [
              {
                "enum": [
                  "IAL-Z1",
                  "IAL-Z2",
                  "IAL-Z3"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Required Level"
          },
          "subject_principal_id": {
            "format": "uuid",
            "title": "Subject Principal Id",
            "type": "string"
          }
        },
        "required": [
          "profile_id",
          "subject_principal_id",
          "purpose",
          "jurisdiction"
        ],
        "title": "StartIn",
        "type": "object"
      }
    }
  },
