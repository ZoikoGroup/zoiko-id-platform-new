            "title": "Downgrade Approval Ref"
          },
          "failing_over_from": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9][a-z0-9_.-]{1,62}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failing Over From"
          },
          "processing_region": {
            "pattern": "^[a-z0-9][a-z0-9_.-]{1,62}$",
            "title": "Processing Region",
            "type": "string"
          },
          "purpose": {
            "pattern": "^[a-z0-9][a-z0-9_.-]{1,62}$",
            "title": "Purpose",
            "type": "string"
          },
          "required_assurance": {
            "default": 0,
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Required Assurance",
            "type": "integer"
          },
          "service_code": {
            "pattern": "^[a-z0-9][a-z0-9_.-]{1,62}$",
            "title": "Service Code",
            "type": "string"
          }
        },
        "required": [
          "country",
          "service_code",
          "purpose",
          "processing_region"
        ],
        "title": "RouteIn",
        "type": "object"
      },
      "V2AgeIn": {
        "additionalProperties": false,
