          "countries": {
            "items": {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            "maxItems": 250,
            "minItems": 1,
            "title": "Countries",
            "type": "array"
          },
          "processing_regions": {
            "items": {
              "pattern": "^[a-z0-9][a-z0-9_.-]{1,62}$",
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Processing Regions",
            "type": "array"
          },
          "purposes": {
            "items": {
              "pattern": "^[a-z0-9][a-z0-9_.-]{1,62}$",
              "type": "string"
            },
            "maxItems": 40,
            "minItems": 1,
            "title": "Purposes",
            "type": "array"
          },
          "service_code": {
            "pattern": "^[a-z0-9][a-z0-9_.-]{1,62}$",
            "title": "Service Code",
            "type": "string"
          },
          "valid_from": {
            "format": "date",
            "title": "Valid From",
            "type": "string"
          },
          "valid_until": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid Until"
          }
        },
        "required": [
          "service_code",
          "countries",
          "purposes",
          "processing_regions",
          "valid_from",
          "assurance"
        ],
        "title": "EntitlementIn",
        "type": "object"
      },
      "zid_platform__modules__verification__api__verification__StartIn": {
        "additionalProperties": false,
