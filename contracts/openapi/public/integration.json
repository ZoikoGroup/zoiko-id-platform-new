{
  "components": {
    "schemas": {
      "AppBody": {
        "additionalProperties": false,
        "properties": {
          "credential_justification": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credential Justification"
          },
          "credential_profile": {
            "$ref": "#/components/schemas/CredentialProfile",
            "default": "private_key_jwt"
          },
          "environment": {
            "$ref": "#/components/schemas/Environment"
          },
          "evidence_floor": {
            "default": 1,
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Evidence Floor",
            "type": "integer"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "owner_principal_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Principal Id"
          },
          "pep_client_id": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pep Client Id"
          },
          "pep_context_fields": {
            "items": {
              "type": "string"
            },
            "maxItems": 30,
            "title": "Pep Context Fields",
            "type": "array"
          },
          "pep_obligations": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "title": "Pep Obligations",
            "type": "array"
          },
          "protocols": {
            "items": {
              "$ref": "#/components/schemas/Protocol"
            },
            "minItems": 1,
            "title": "Protocols",
            "type": "array"
          },
          "redirect_uris": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Redirect Uris",
            "type": "array"
          },
          "resource_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "title": "Resource Ids",
            "type": "array"
          },
          "risk_floor": {
            "default": 1,
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Risk Floor",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "environment",
          "protocols"
        ],
        "title": "AppBody",
        "type": "object"
      },
      "AppStatus": {
        "enum": [
          "DRAFT",
          "TESTING",
          "ACTIVE",
          "SUSPENDED",
          "RETIRED"
        ],
        "title": "AppStatus",
        "type": "string"
      },
      "AuthProfile": {
        "enum": [
          "OAUTH_CLIENT",
          "MTLS",
          "WORKLOAD_IDENTITY",
          "SECRET"
        ],
        "title": "AuthProfile",
        "type": "string"
      },
      "Capability": {
        "enum": [
          "AUTHN",
          "PROVISIONING",
          "GROUPS",
          "HR_LIFECYCLE",
          "SIGNALS",
          "WEBHOOK",
          "DIRECTORY_LOOKUP"
        ],
        "title": "Capability",
        "type": "string"
      },
      "ConnectorBody": {
        "additionalProperties": false,
        "properties": {
          "auth_profile": {
            "$ref": "#/components/schemas/AuthProfile",
            "default": "OAUTH_CLIENT"
          },
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "minItems": 1,
            "title": "Capabilities",
            "type": "array"
          },
          "connector_type": {
            "$ref": "#/components/schemas/ConnectorType"
          },
          "disable_behavior": {
            "$ref": "#/components/schemas/DisableBehavior",
            "default": "FAIL_CLOSED_HIGH_RISK"
          },
          "display_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "freshness_minutes": {
            "anyOf": [
              {
                "maximum": 10080.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Freshness Minutes"
          },
          "owner_principal_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Principal Id"
          },
          "source_of_truth_scope": {
            "items": {
              "type": "string"
            },
            "maxItems": 30,
            "title": "Source Of Truth Scope",
            "type": "array"
          },
          "source_ref": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Ref"
          }
        },
        "required": [
          "connector_type",
          "display_name",
          "capabilities"
        ],
        "title": "ConnectorBody",
        "type": "object"
      },
      "ConnectorType": {
        "enum": [
          "OIDC_IDP",
          "SAML_IDP",
          "SCIM",
          "HRIS",
          "SIGNALS",
          "WEBHOOK",
          "DIRECTORY"
        ],
        "title": "ConnectorType",
        "type": "string"
      },
      "CredentialBody": {
        "additionalProperties": false,
        "properties": {
          "not_after": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Not After"
          },
          "overlap_hours": {
            "default": 24,
            "maximum": 168.0,
            "minimum": 0.0,
            "title": "Overlap Hours",
            "type": "integer"
          },
          "secret": {
            "maxLength": 8192,
            "minLength": 16,
            "title": "Secret",
            "type": "string"
          }
        },
        "required": [
          "secret"
        ],
        "title": "CredentialBody",
        "type": "object"
      },
      "CredentialProfile": {
        "enum": [
          "private_key_jwt",
          "mtls",
          "workload_identity",
          "secret_exception"
        ],
        "title": "CredentialProfile",
        "type": "string"
      },
      "DisableBehavior": {
        "enum": [
          "FAIL_CLOSED_HIGH_RISK",
          "SUSPEND_DEPENDENTS"
        ],
        "title": "DisableBehavior",
        "type": "string"
      },
      "Environment": {
        "enum": [
          "DEV",
          "TEST",
          "STAGE",
          "PROD"
        ],
        "title": "Environment",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MappingBody": {
        "additionalProperties": false,
        "properties": {
          "rules": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "Rules",
            "type": "array"
          }
        },
        "required": [
          "rules"
        ],
        "title": "MappingBody",
        "type": "object"
      },
      "OAuthClientBody": {
        "additionalProperties": false,
        "description": "`purpose` SIGN_IN (default): a client people sign in through (redirect addresses required). DECISIONS: the machine client an application uses to\nask the decision API (a signed key, no redirect address, no scopes to choose); a client people sign in through cannot get a machine token.",
        "properties": {
          "client_type": {
            "enum": [
              "PUBLIC",
              "CONFIDENTIAL"
            ],
            "title": "Client Type",
            "type": "string"
          },
          "jwks": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jwks"
          },
          "name": {
            "maxLength": 80,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "purpose": {
            "default": "SIGN_IN",
            "enum": [
              "SIGN_IN",
              "DECISIONS"
            ],
            "title": "Purpose",
            "type": "string"
          },
          "redirect_uris": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "title": "Redirect Uris",
            "type": "array"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "title": "Scopes",
            "type": "array"
          }
        },
        "required": [
          "name",
          "client_type"
        ],
        "title": "OAuthClientBody",
        "type": "object"
      },
      "Protocol": {
        "enum": [
          "OIDC",
          "SAML",
          "SCIM",
          "AUTHZEN",
          "WEBHOOK",
          "API",
          "MCP",
          "OTHER"
        ],
        "title": "Protocol",
        "type": "string"
      },
      "RouteKind": {
        "enum": [
          "APPLICATION",
          "DOMAIN"
        ],
        "title": "RouteKind",
        "type": "string"
      },
      "SandboxIdentitiesBody": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "default": 1,
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Count",
            "type": "integer"
          },
          "days": {
            "default": 14,
            "maximum": 90.0,
            "minimum": 1.0,
            "title": "Days",
            "type": "integer"
          },
          "prefix": {
            "default": "test",
            "pattern": "^[a-z][a-z0-9-]{0,30}$",
            "title": "Prefix",
            "type": "string"
          }
        },
        "title": "SandboxIdentitiesBody",
        "type": "object"
      },
      "SimulateBody": {
        "additionalProperties": false,
        "properties": {
          "records": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "maxItems": 1000,
            "minItems": 1,
            "title": "Records",
            "type": "array"
          }
        },
        "required": [
          "records"
        ],
        "title": "SimulateBody",
        "type": "object"
      },
      "Transition": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "$ref": "#/components/schemas/AppStatus"
          }
        },
        "required": [
          "status"
        ],
        "title": "Transition",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "zid_platform__modules__integration__api__integration__QuarantineBody": {
        "additionalProperties": false,
        "properties": {
          "reason_code": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "title": "Reason Code",
            "type": "string"
          }
        },
        "required": [
          "reason_code"
        ],
        "title": "QuarantineBody",
        "type": "object"
      },
      "zid_platform__modules__integration__api__integration__ReleaseBody": {
        "additionalProperties": false,
        "properties": {
          "approval_request_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Approval Request Id",
            "type": "string"
          }
        },
        "required": [
          "approval_request_id"
        ],
        "title": "ReleaseBody",
        "type": "object"
      },
      "zid_platform__modules__integration__api__integration__ResolveBody": {
        "additionalProperties": false,
        "properties": {
          "application_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Application Id"
          },
          "login_domain": {
            "anyOf": [
              {
                "maxLength": 253,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Login Domain"
          }
        },
        "title": "ResolveBody",
        "type": "object"
      },
      "zid_platform__modules__integration__api__integration__RouteBody": {
        "additionalProperties": false,
        "properties": {
          "connection_ref": {
            "maxLength": 120,
            "minLength": 10,
            "title": "Connection Ref",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/RouteKind"
          },
          "match": {
            "maxLength": 253,
            "minLength": 1,
            "title": "Match",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "match",
          "connection_ref"
        ],
        "title": "RouteBody",
        "type": "object"
      }
    }
  },
