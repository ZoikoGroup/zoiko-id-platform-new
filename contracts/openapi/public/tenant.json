{
  "components": {
    "schemas": {
      "Approved": {
        "additionalProperties": false,
        "properties": {
          "approval_request_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Approval Request Id",
            "type": "string"
          },
          "reason_code": {
            "default": "OWNER_REQUEST",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "title": "Reason Code",
            "type": "string"
          }
        },
        "required": [
          "approval_request_id"
        ],
        "title": "Approved",
        "type": "object"
      },
      "DomainBody": {
        "additionalProperties": false,
        "properties": {
          "domain": {
            "maxLength": 253,
            "minLength": 3,
            "title": "Domain",
            "type": "string"
          },
          "method": {
            "$ref": "#/components/schemas/Method",
            "default": "DNS_TXT"
          }
        },
        "required": [
          "domain"
        ],
        "title": "DomainBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Invite": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role",
            "default": "MEMBER"
          }
        },
        "title": "Invite",
        "type": "object"
      },
      "Method": {
        "enum": [
          "DNS_TXT",
          "HTTPS_WELL_KNOWN"
        ],
        "title": "Method",
        "type": "string"
      },
      "OwnerChange": {
        "additionalProperties": false,
        "properties": {
          "approval_request_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Approval Request Id",
            "type": "string"
          },
          "principal_id": {
            "format": "uuid",
            "title": "Principal Id",
            "type": "string"
          }
        },
        "required": [
          "principal_id",
          "approval_request_id"
        ],
        "title": "OwnerChange",
        "type": "object"
      },
      "Role": {
        "enum": [
          "OWNER",
          "ADMIN",
          "APPROVER",
          "OPERATOR",
          "VIEWER",
          "MEMBER"
        ],
        "title": "Role",
        "type": "string"
      },
      "Suspend": {
        "additionalProperties": false,
        "properties": {
          "reason_code": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "title": "Reason Code",
            "type": "string"
          }
        },
        "required": [
          "reason_code"
        ],
        "title": "Suspend",
        "type": "object"
      },
      "TenantCreate": {
        "additionalProperties": false,
        "properties": {
          "deployment_mode": {
            "default": "O1",
            "pattern": "^O[0-3]$",
            "title": "Deployment Mode",
            "type": "string"
          },
          "display_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "tenant_slug": {
            "maxLength": 63,
            "minLength": 1,
            "title": "Tenant Slug",
            "type": "string"
          }
        },
        "required": [
          "display_name",
          "tenant_slug"
        ],
        "title": "TenantCreate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
