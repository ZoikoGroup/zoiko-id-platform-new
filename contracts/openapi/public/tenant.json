{
  "components": {
    "schemas": {
      "Approved": {
        "additionalProperties": false,
        "properties": {
          "approval_request_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Approval Request Id",
            "type": "string"
          },
          "reason_code": {
            "default": "OWNER_REQUEST",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "title": "Reason Code",
            "type": "string"
          }
        },
        "required": [
          "approval_request_id"
        ],
        "title": "Approved",
        "type": "object"
      },
      "CaseCreate": {
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Action Id",
            "type": "string"
          },
          "evidence_ref": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Ref"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "target_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Target Id",
            "type": "string"
          },
          "ttl_seconds": {
            "anyOf": [
              {
                "minimum": 60.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ttl Seconds"
          }
        },
        "required": [
          "action_id",
          "target_id",
          "reason"
        ],
        "title": "CaseCreate",
        "type": "object"
      },
      "CaseRevise": {
        "additionalProperties": false,
        "properties": {
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "payload",
          "reason"
        ],
        "title": "CaseRevise",
        "type": "object"
      },
      "Containment": {
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Action Id",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "action_id",
          "reason"
        ],
        "title": "Containment",
        "type": "object"
      },
      "DomainBody": {
        "additionalProperties": false,
        "properties": {
          "domain": {
            "maxLength": 253,
            "minLength": 3,
            "title": "Domain",
            "type": "string"
          },
          "method": {
            "$ref": "#/components/schemas/Method",
            "default": "DNS_TXT"
          }
        },
        "required": [
          "domain"
        ],
        "title": "DomainBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Invite": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role",
            "default": "MEMBER"
          }
        },
        "title": "Invite",
        "type": "object"
      },
      "Method": {
        "enum": [
          "DNS_TXT",
          "HTTPS_WELL_KNOWN"
        ],
        "title": "Method",
        "type": "string"
      },
      "OwnerChange": {
        "additionalProperties": false,
        "properties": {
          "approval_request_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Approval Request Id",
            "type": "string"
          },
          "principal_id": {
            "format": "uuid",
            "title": "Principal Id",
            "type": "string"
          }
        },
        "required": [
          "principal_id",
          "approval_request_id"
        ],
        "title": "OwnerChange",
        "type": "object"
      },
      "RecoveryOpen": {
        "additionalProperties": false,
        "properties": {
          "identity_reproof_ref": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Identity Reproof Ref",
            "type": "string"
          },
          "principal_id": {
            "format": "uuid",
            "title": "Principal Id",
            "type": "string"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "principal_id",
          "identity_reproof_ref",
          "reason"
        ],
        "title": "RecoveryOpen",
        "type": "object"
      },
      "ReviewerAppoint": {
        "additionalProperties": false,
        "properties": {
          "authority_basis": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Authority Basis",
            "type": "string"
          },
          "declared_conflicts": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 50,
            "title": "Declared Conflicts",
            "type": "array"
          },
          "independence_declaration": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Independence Declaration",
            "type": "string"
          },
          "principal_id": {
            "format": "uuid",
            "title": "Principal Id",
            "type": "string"
          },
          "relationship": {
            "enum": [
              "EXTERNAL_PROFESSIONAL",
              "CO_DIRECTOR",
              "TRUSTEE",
              "AUTHORIZED_DELEGATE"
            ],
            "title": "Relationship",
            "type": "string"
          }
        },
        "required": [
          "principal_id",
          "relationship",
          "authority_basis",
          "independence_declaration"
        ],
        "title": "ReviewerAppoint",
        "type": "object"
      },
      "Role": {
        "enum": [
          "OWNER",
          "ADMIN",
          "APPROVER",
          "OPERATOR",
          "VIEWER",
          "MEMBER"
        ],
        "title": "Role",
        "type": "string"
      },
      "State": {
        "enum": [
          "DRAFT",
          "SUBMITTED",
          "PENDING_APPROVAL",
          "PARTIALLY_APPROVED",
          "APPROVED_READY",
          "EXECUTED",
          "FAILED",
          "REJECTED",
          "EXPIRED",
          "INVALIDATED",
          "CANCELLED"
        ],
        "title": "State",
        "type": "string"
      },
      "Suspend": {
        "additionalProperties": false,
        "properties": {
          "reason_code": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "title": "Reason Code",
            "type": "string"
          }
        },
        "required": [
          "reason_code"
        ],
        "title": "Suspend",
        "type": "object"
      },
      "TenantCreate": {
        "additionalProperties": false,
        "properties": {
          "deployment_mode": {
            "default": "O1",
            "pattern": "^O[0-3]$",
            "title": "Deployment Mode",
            "type": "string"
          },
          "display_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "tenant_slug": {
            "maxLength": 63,
            "minLength": 1,
            "title": "Tenant Slug",
            "type": "string"
          }
        },
        "required": [
          "display_name",
          "tenant_slug"
        ],
        "title": "TenantCreate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VoteBody": {
        "additionalProperties": false,
        "description": "The vote and the hash the approver reviewed. Nothing about quorum, identity or freshness is taken from here.",
        "properties": {
          "request_hash": {
            "maxLength": 64,
            "minLength": 64,
            "title": "Request Hash",
            "type": "string"
          },
          "vote": {
            "enum": [
              "APPROVE",
              "REJECT"
            ],
            "title": "Vote",
            "type": "string"
          }
        },
        "required": [
          "vote",
          "request_hash"
        ],
        "title": "VoteBody",
        "type": "object"
      }
    }
  },
