          "token"
        ],
        "title": "ConfirmChangeBody",
        "type": "object"
      },
      "ContactBody": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Address",
            "type": "string"
          },
          "purpose": {
            "enum": [
              "OWNER",
              "BILLING",
              "SECURITY",
              "TECHNICAL"
            ],
            "title": "Purpose",
            "type": "string"
          }
        },
        "required": [
          "purpose",
          "address"
