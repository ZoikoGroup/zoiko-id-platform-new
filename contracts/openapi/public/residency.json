{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ResidencyBody": {
        "additionalProperties": false,
        "properties": {
          "approval_ref": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Approval Ref",
            "type": "string"
          },
          "approval_request_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Request Id"
          },
          "home_cell_id": {
            "pattern": "^[a-z0-9-]{1,40}$",
            "title": "Home Cell Id",
            "type": "string"
          },
          "jurisdiction_pack_id": {
            "title": "Jurisdiction Pack Id",
            "type": "string"
          },
          "key_profile": {
            "default": "PLATFORM_MANAGED",
            "pattern": "^(PLATFORM_MANAGED|DEDICATED_TENANT_KEY|BYOK|HYOK)$",
            "title": "Key Profile",
            "type": "string"
          },
          "operator_jurisdictions": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Operator Jurisdictions",
            "type": "array"
          },
          "permitted_recovery_cells": {
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "title": "Permitted Recovery Cells",
            "type": "array"
          },
          "prohibited_cells": {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "title": "Prohibited Cells",
            "type": "array"
          },
          "residency_profile_id": {
            "pattern": "^SRP-[0-3]$",
            "title": "Residency Profile Id",
            "type": "string"
          }
        },
        "required": [
          "residency_profile_id",
          "home_cell_id",
          "jurisdiction_pack_id",
          "approval_ref"
        ],
        "title": "ResidencyBody",
        "type": "object"
      },
      "RuleBody": {
        "additionalProperties": false,
        "properties": {
          "approval_ref": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Approval Ref",
            "type": "string"
          },
          "approval_request_id": {
            "format": "uuid",
            "title": "Approval Request Id",
            "type": "string"
          },
          "data_class": {
            "pattern": "^DC[1-3]$",
            "title": "Data Class",
            "type": "string"
          },
          "destination_cell_id": {
            "pattern": "^[a-z0-9-]{1,40}$",
            "title": "Destination Cell Id",
            "type": "string"
          },
          "field_allowlist": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Field Allowlist",
            "type": "array"
          },
          "mechanism": {
            "maxLength": 64,
            "minLength": 2,
            "title": "Mechanism",
            "type": "string"
          },
          "purpose_code": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "title": "Purpose Code",
            "type": "string"
          },
          "valid_to": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid To"
          }
        },
        "required": [
          "data_class",
          "destination_cell_id",
          "purpose_code",
          "mechanism",
          "approval_ref",
          "approval_request_id"
        ],
        "title": "RuleBody",
        "type": "object"
      },
      "TransferBody": {
        "additionalProperties": false,
        "properties": {
          "data_class": {
            "pattern": "^(DC0|DC1|DC2|DC3|KEY_MATERIAL)$",
            "title": "Data Class",
            "type": "string"
          },
          "destination_cell_id": {
            "pattern": "^[a-z0-9-]{1,40}$",
            "title": "Destination Cell Id",
            "type": "string"
          },
          "purpose_code": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "title": "Purpose Code",
            "type": "string"
          }
        },
        "required": [
          "data_class",
          "destination_cell_id",
          "purpose_code"
        ],
        "title": "TransferBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Zoiko iD Tenant Residency and Sovereignty API",
    "version": "1.0.0"
  },
