  "info": {
    "description": "Verify your own customers from your own server. Exchange your client credentials for a short-lived bearer token, create a verification session with an Idempotency-Key, send your customer to the launch link, and read the minimized decision. Everything here runs in the sandbox until your company is approved to go live.",
    "title": "Zoiko iD Verify API",
    "version": "1"
  },
