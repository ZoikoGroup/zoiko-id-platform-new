{
  "components": {
    "schemas": {
      "Action": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "Action",
        "type": "object"
      },
      "Entity": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "properties": {
            "additionalProperties": true,
            "title": "Properties",
            "type": "object"
          },
          "type": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "id"
        ],
        "title": "Entity",
        "type": "object"
      },
      "EvaluationContext": {
        "description": "Zoiko extensions: optional and namespaced by meaning; unknown keys are ignored (API \u00a74).",
        "properties": {
          "incumbent_decision": {
            "anyOf": [
              {
                "enum": [
                  "ALLOW",
                  "DENY"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Incumbent Decision"
          },
          "mandate_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mandate Id"
          },
          "purpose": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purpose"
          },
          "represented_principal_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Represented Principal Id"
          },
          "risk_class": {
            "anyOf": [
              {
                "pattern": "^R[0-3]$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Class"
          },
          "tool_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Id"
          },
          "transaction_context_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transaction Context Id"
          },
          "value": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Value"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "EvaluationContext",
        "type": "object"
      },
      "EvaluationRequest": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "context": {
            "$ref": "#/components/schemas/EvaluationContext"
          },
          "resource": {
            "$ref": "#/components/schemas/Entity"
          },
          "subject": {
            "$ref": "#/components/schemas/Entity"
          }
        },
        "required": [
          "subject",
          "action",
          "resource"
        ],
        "title": "EvaluationRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Value": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "title": "Value",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Zoiko iD AuthZEN Authorization API (OpenID AuthZEN 1.0 profile)",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/access/v1/evaluation": {
      "post": {
        "operationId": "evaluation_access_v1_evaluation_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Evaluation Access V1 Evaluation Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evaluation",
        "tags": [
          "authzen"
        ]
      }
    }
  }
}
