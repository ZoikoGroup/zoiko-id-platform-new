# Public assistant: environment template (ZI-CHAT-ADR-006). Copy to backend/assistant/.env (gitignored) for local development.
# Every setting uses the ZID_ASSISTANT_ prefix. This service reads NO platform (ZID_*) setting and holds no identity configuration.
# EVERY FEATURE DEFAULTS TO OFF. The values below turn on the local demo only; none of this is approved for production.

ZID_ASSISTANT_ENVIRONMENT=local
ZID_ASSISTANT_PORT=8210

# --- feature flags (all default false). The kill switch overrides everything; flip it at runtime with `python -m zid_assistant.flags_cli` ---
ZID_ASSISTANT_ENABLED=true
# Model-drafted answers: OFF until OD-010/016/017 are decided. With the mock provider this only exercises the verified-draft path.
ZID_ASSISTANT_AI_ANSWERS=false
ZID_ASSISTANT_MODEL_PROVIDER=mock
# Real model (later, after the vendor/DPA decision): provider claude + a key FILE (never an inline key)
# Providers: claude | groq | gemini (key always from a gitignored FILE, e.g. .local-keys/groq.key)
# ZID_ASSISTANT_MODEL_PROVIDER=groq  (name openai/gpt-oss-120b)  or  gemini (name gemini-3.8-flash)
# ZID_ASSISTANT_MODEL_PROVIDER=claude
# ZID_ASSISTANT_MODEL_API_KEY_FILE=D:/path/to/anthropic.key
# Forms stay unavailable until a market, a signed notice revision and a flag are ALL set (OD-009..015). Local demo values:
ZID_ASSISTANT_INTAKE_SALES=false
ZID_ASSISTANT_INTAKE_SUPPORT=false
# ZID_ASSISTANT_INTAKE_COUNTRIES=["US","GB"]
# ZID_ASSISTANT_INTAKE_NOTICE_SALES_ID=local-dev-notice-sales
# ZID_ASSISTANT_INTAKE_NOTICE_SUPPORT_ID=local-dev-notice-support

# --- who may call: first-party host origins only (the platform web app locally; add the website's origin when you run it) ---
ZID_ASSISTANT_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- state ---
# Local Postgres from `docker compose up -d postgres` (ZID_DB_HOST_PORT=5440): the assistant has its OWN database and role.
#   python -m zid_assistant.migrate   (needs the owner URL below)
ZID_ASSISTANT_MIGRATION_DATABASE_URL=postgresql+asyncpg://zid:zid_local_only@localhost:5440/zid_assistant
ZID_ASSISTANT_DATABASE_URL=postgresql+asyncpg://zid_assistant:zid_assistant_local_only@localhost:5440/zid_assistant
# Shared session/flag store. Leave unset for a single local process (in-memory).
# ZID_ASSISTANT_VALKEY_URL=redis://localhost:6390/0

# --- content: signed snapshot (production refuses a sample or unsigned snapshot) ---
# ZID_ASSISTANT_SNAPSHOT_SIGNATURE_FILE=...
# ZID_ASSISTANT_SNAPSHOT_PUBLIC_KEY_FILE=...
