# Keep the image build context small and secret-free (build context: backend/).
.venv/
venv/
**/__pycache__/
**/*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/
build/
dist/
**/*.egg-info/
**/.gitkeep
**/*.log
# Secrets must never enter an image layer (ADR-0026, ADR-0027)
.env
.env.*
**/*.pem
**/*.key
