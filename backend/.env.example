# Zoiko iD backend: environment template.
#
# Local development: copy to backend/.env (gitignored). tools/scripts/run_local.py and
# tools/scripts/bootstrap_local.py load it; variables already set in the shell win.
# Deployed cells do NOT use this file: config comes from the platform and secrets from the
# secrets broker (DEC-F5). Never put a production secret here.
#
# Every setting uses the ZID_ prefix. List values (marked JSON) are JSON arrays.
# Values below are the local defaults; "(deployed)" notes say what changes outside local.

# ---------------------------------------------------------------------------------------------
# 1. Identity of this process
# ---------------------------------------------------------------------------------------------
# local | test | dev | sandbox | production. Development keys and env-var secrets only work in local/test.
ZID_ENVIRONMENT=local
# Cell this process serves. The launcher sets it per role (cell: this value, global: "global").
ZID_CELL_ID=local-1
# UUID of this cell in agent.writer_fence (DEC-C5). Mandate ledger writes are refused without it.
# bootstrap_local.py registers this cell as the writer for the local tenant.
ZID_CELL_UUID=6f1c2d3e-0000-4000-8000-00000000c311
# Region label on emitted events (defaults to ZID_CELL_ID).
ZID_REGION=local-1
ZID_LOG_LEVEL=INFO
ZID_SERVICE_VERSION=0.1.0

# ---------------------------------------------------------------------------------------------
# 2. Processes and ports (supervisor in Docker, run_local.py on a laptop)
# ---------------------------------------------------------------------------------------------
# Roles to run in one container: "cell,global" locally; "cell" or "global" when deployed.
ZID_ROLES=cell,global
ZID_CELL_PORT=8000
ZID_GLOBAL_PORT=8100
# Interface uvicorn binds to inside a container (run_local.py always binds 127.0.0.1).
ZID_BIND_HOST=0.0.0.0

# ---------------------------------------------------------------------------------------------
# 3. Databases (PostgreSQL 17 in Docker: `docker compose up -d postgres`)
# ---------------------------------------------------------------------------------------------
# Password of the local Postgres user `zid` (docker-compose.yml reads it too). Laptop only.
ZID_DB_PASSWORD=zid_local_only
# Host port Postgres is published on (127.0.0.1 only).
ZID_DB_HOST_PORT=5432
# Per-role databases. The supervisor/launcher passes each role only its own URL as ZID_DATABASE_URL;
# the cell and global planes never share a database (ZID-TENANCY-001 §2).
ZID_CELL_DATABASE_URL=postgresql+asyncpg://zid:zid_local_only@localhost:5432/zid_cell
ZID_GLOBAL_DATABASE_URL=postgresql+asyncpg://zid:zid_local_only@localhost:5432/zid_global
# Outbox relay (DEC-D2) and maintenance jobs; leave empty unless you run those processes.
# (deployed) dedicated least-privilege roles, short-lived credentials from the broker.
ZID_RELAY_DATABASE_URL=
ZID_MAINTENANCE_DATABASE_URL=

# ---------------------------------------------------------------------------------------------
# 4. OAuth / OIDC authorization server and resource server (session module)
# ---------------------------------------------------------------------------------------------
# Exact `iss` of tokens this cell issues and accepts. Setting it turns on /oauth2/*, sign-in,
# federation and credentials. Must equal ZID_TOKEN_ISSUER in frontend/apps/web/.env.local.
ZID_TOKEN_ISSUER=http://localhost:8000
# Audience of access tokens for this API. The web app's OAuth client lists it in `audiences`.
ZID_TOKEN_AUDIENCE=http://localhost:8000
# Canonical external URL of the API, used as DPoP `htu`.
ZID_PUBLIC_BASE_URL=http://localhost:8000
# Consent page for THIRD-PARTY OAuth clients (first-party clients such as zoiko-web skip consent).
# The cell appends ?consent_request=<ref>; the web app's /consent page reads it. Empty = consent_required.
ZID_CONSENT_URL=http://localhost:3000/consent

# ---------------------------------------------------------------------------------------------
# 5. Passkeys (WebAuthn)
# ---------------------------------------------------------------------------------------------
# Relying-party id: a registrable domain, never an IP address. Locally the web app runs on
# http://localhost:3000, so the RP id is `localhost`. Leaving it empty disables passkeys.
ZID_WEBAUTHN_RP_ID=localhost
ZID_WEBAUTHN_RP_NAME=Zoiko iD (local)
# JSON: exact origins allowed to run ceremonies; must include the web app's ZID_PUBLIC_ORIGIN.
ZID_WEBAUTHN_ORIGINS=["http://localhost:3000"]
# JSON: governed Related Origin Requests list (FR-AUT-010). Usually empty.
ZID_WEBAUTHN_RELATED_ORIGINS=[]

# ---------------------------------------------------------------------------------------------
# 6. Signing keys (DEC-F5)
# ---------------------------------------------------------------------------------------------
# local/test only: JSON object purpose -> PEM private key, so the API and the consumer process
# share keys (purposes: token, set, federation, credential, verifier). Empty = each process makes
# its own development keys at start-up (tokens stop verifying after a restart; sign in again).
# (deployed) forbidden: cells refuse to start with it and use KMS/HSM-backed signers.
ZID_DEV_SIGNING_KEYS=

# ---------------------------------------------------------------------------------------------
# 7. Federation, credentials and mTLS
# ---------------------------------------------------------------------------------------------
# JSON: superiors listed in our OpenID Federation entity configuration.
ZID_FEDERATION_AUTHORITY_HINTS=[]
# OID4VP verifier client id scheme: openid_federation | x509_hash (HAIP).
ZID_VERIFIER_CLIENT_ID_PREFIX=openid_federation
# JSON: verifier certificate chain (PEM, leaf first) for x509_hash; local uses a self-signed dev cert.
ZID_VERIFIER_CERTIFICATE_CHAIN=[]
# Header carrying the URL-encoded client certificate from the TLS terminator (e.g. x-client-cert).
# Set ONLY when the edge strips it from inbound requests; leave empty locally.
ZID_MTLS_CLIENT_CERT_HEADER=
# local/test brokered secrets: ZID_SECRET__<REF> (ref upper-cased, '-' -> '_'), e.g. the client
# secret of an enterprise OIDC connection whose secret_ref is "acme-oidc":
# ZID_SECRET__ACME_OIDC=

# ---------------------------------------------------------------------------------------------
# 8. Event backbone and relationship store (only for the relay/consumer processes)
# ---------------------------------------------------------------------------------------------
# Kafka bootstrap servers for entrypoints.outbox_relay and entrypoints.consumer (DEC-D2).
ZID_KAFKA_BOOTSTRAP=
# SpiceDB endpoint and preshared key for the relationship projection consumer (DEC-C4).
ZID_SPICEDB_URL=
ZID_SPICEDB_KEY=

# ---------------------------------------------------------------------------------------------
# 9. File locations (defaults resolve inside the source tree; the Docker image sets its own)
# ---------------------------------------------------------------------------------------------
# ZID_ACTION_CATALOG=../contracts/action-catalog/actions.yaml
# ZID_POLICY_DIR=policies
# ZID_MIGRATIONS_DIR=app/migrations

# ---------------------------------------------------------------------------------------------
# 10. Keys and secrets (DEC-F5; zid_crypto broker via zid_platform/crypto_runtime.py)
# ---------------------------------------------------------------------------------------------
# Key provider for envelope encryption KEKs and HMAC keys: local | aws-kms.
# local = development keys, local/test only (refuses any other ZID_ENVIRONMENT).
# (deployed) aws-kms: one KMS key per purpose per cell; the app never sees a KEK.
ZID_KEY_PROVIDER=local
# local only: JSON keystore so local processes share development KEKs (empty = in-memory, per start).
ZID_LOCAL_KEYSTORE=
# aws-kms: region, and KMS key id/ARN/alias per purpose (JSON). Purposes not listed fall back to
# ZID_KMS_KEY_ALIAS_PATTERN ({cell} = ZID_CELL_ID, {purpose} = lower-case purpose, e.g. data_kek).
# ZID_KMS_REGION=eu-west-2
# ZID_KMS_KEY_IDS={"DATA_KEK": "alias/zid/eu-1/data_kek", "SUBJECT_ERASURE_KEY": "alias/zid/eu-1/subject_erasure_key"}
# ZID_KMS_KEY_ALIAS_PATTERN=alias/zid/{cell}/{purpose}
# Days KMS keeps a key pending deletion after destroy_key (7-30).
# ZID_KMS_PENDING_WINDOW_DAYS=30
# Crypto Policy Registry file (default: backend/config/crypto-profiles/crypto-policy-registry.yaml).
# ZID_CRYPTO_POLICY_REGISTRY=config/crypto-profiles/crypto-policy-registry.yaml
# Secrets broker: env (ZID_SECRET__<REF>, see section 7; local/test only) | openbao.
ZID_SECRET_BROKER=env
# (deployed) openbao: the cell's OpenBao, KV v2 mount and auth. Credentials come from FILES
# (a JWT-SVID written by the SPIFFE helper, or a token file), never from an env value.
# ZID_OPENBAO_ADDR=https://openbao.cell.internal:8200
# ZID_OPENBAO_KV_MOUNT=secret
# ZID_OPENBAO_NAMESPACE=
# ZID_OPENBAO_AUTH=jwt
# ZID_OPENBAO_JWT_MOUNT=jwt
# ZID_OPENBAO_JWT_ROLE=zid-platform
# ZID_OPENBAO_JWT_FILE=/run/spiffe/jwt-svid
# ZID_OPENBAO_TOKEN_FILE=

# --- Phase F: evidence, operator plane, workload identity (local defaults shown) -------------
# Evidence keys: locally the dev "evidence" key in ZID_DEV_SIGNING_KEYS (bootstrap_local.py adds it);
# deployed cells use ZID_KEY_PROVIDER=aws-kms with the cell's EVIDENCE_SIGNING / HMAC_INTERNAL /
# SUBJECT_ERASURE_KEY keys. Retired evidence public keys stay trusted via ZID_EVIDENCE_HISTORIC_KEYS.
# ZID_LOCAL_KEYSTORE=.zid/keystore.json   # share development KEKs between the API and the worker
# ZID_EVIDENCE_TSA_URL=                   # optional RFC 3161 timestamp authority
# ZID_EVIDENCE_TSA_TRUST_FILE=             # PEM of the TSA root certificates; required when the URL is set
# ZID_EVIDENCE_TSA_REVOCATION=if_available  # off | if_available | required (required: a missing CRL fails the timestamp)
# Operator Console (apps/operator on http://localhost:3100): `bootstrap_local.py --operator` prints
# the operator tenant; also add http://localhost:3100 to ZID_WEBAUTHN_ORIGINS.
# ZID_OPERATOR_TENANT_ID=00000000-0000-4000-8000-0000000000e1
# Operator plane mode: governed (default: operators request just-in-time access and a second person approves) | direct
# (a registered operator holds every capability that does not touch customer data, with no request and no second
# approver; sign-in, step-up, evidence and the customer lockbox stay). Direct mode suits a small team that runs the
# platform with one account; the cell logs a warning at start-up and the console shows a banner.
# ZID_OPERATOR_MODE=governed
# Outside local/test/dev, direct mode also needs this exact value, so dropping dual control is a deliberate act:
# ZID_OPERATOR_DIRECT_ACK=accept-no-dual-control
# Onboarding approvals (CR-036): second_admin (default: approving a plan, starting a pilot, activating the company and
# activating a pilot scope need an independent second administrator) | owner (the company's OWNER approves them alone).
# Outside local/test/dev, owner also needs ZID_ONBOARDING_OWNER_ACK=accept-no-second-admin.
# ZID_ONBOARDING_APPROVAL=second_admin
# ZID_ONBOARDING_OWNER_ACK=
# First operator account from configuration (all deployments; local can still use bootstrap_local.py --operator):
#   python -m zid_platform.entrypoints.bootstrap_operator --ticket
# creates the operator principal, the Operator Console OAuth client and the operator profile if missing (idempotent)
# and prints one single-use passkey enrollment link. Keep the principal uuid: it is the operator's identity.
# ZID_OPERATOR_BOOTSTRAP_PRINCIPAL_ID=00000000-0000-4000-8000-0000000000e2
# ZID_OPERATOR_ORIGIN=http://127.0.0.1:3100        # deployed: https://operator.<domain>
# ZID_OPERATOR_REDIRECT_URIS=                       # JSON list; default [<origin>/auth/callback] (https or loopback IP only)
# ZID_OPERATOR_JURISDICTION=GB
# ZID_OPERATOR_BOOTSTRAP_ROLES=["REQUESTER","APPROVER","REVIEWER"]
# ZID_OPERATOR_BOOTSTRAP_TICKET_MINUTES=60
# ZID_OPERATOR_CLIENT_IDS=["zoiko-operator"]
# Operator Console email + password sign-in (the only password sign-in; everyone else uses passkeys). The migration step
# (`python -m zid_platform.entrypoints.migrate`, the compose `migrate` service) creates this operator when the tenant, email
# and password are all set, and the cell signs them in; the password is hashed in memory and never stored in plain text.
# Use a long, unique password and keep this file out of version control. The operator app also needs ZID_OPERATOR_PASSWORD_SIGNIN=true.
# ZID_OPERATOR_EMAIL=operator@example.com
# ZID_OPERATOR_PASSWORD=
# Workload identity (SPIFFE): see local/spire/bootstrap.sh for the development SPIRE profile.
# ZID_SPIFFE_TRUST_DOMAIN=local-1.local.id.zoiko
# ZID_SPIFFE_BUNDLE_FILES={"local-1.local.id.zoiko": "../local/spire/bundle.pem"}
# Company-verification proof documents (WF-13B AT-12): the clamd malware scanner (host[:port], default port 3310) that checks every
# uploaded file before it is stored. A deployed environment WITHOUT one refuses uploads (nothing is stored unscanned); local and test
# record the file as NOT_SCANNED. Run it in the same data region as the files it scans.
# ZID_PROOF_SCANNER_ADDRESS=clamd.internal:3310
# --- Keys without a KMS (CR-060; standard assurance, see docs/runbooks/software-keys.md) ---
# ZID_KEY_PROVIDER=db                     # keys live in PostgreSQL, wrapped by a master key kept OUTSIDE the database
# ZID_KEY_MASTER_FILE=/zid/master_key     # python -m zid_platform.entrypoints.keys init-master --file ...; copy it offline
# ZID_KEY_PROVIDER_DB_ACK=accept-software-keys   # required in a deployed environment: the written risk acceptance
# --- Evidence integrity (CR-060 addendum) ---
# ZID_EVIDENCE_TSA_REQUIRED=false             # true: nothing is sealed without an external timestamp (entries stay visibly unsealed)
# ZID_EVIDENCE_VERIFY_INTERVAL=21600          # seconds between scheduled re-verifications of each evidence partition (0 = off)
# ZID_EVIDENCE_VERIFY_BATCH=2                 # partitions checked per worker pass
# ZID_EVIDENCE_TSA_WAIVER=accept-no-external-timestamps   # only to run software keys WITHOUT a timestamp authority: the owners' written acceptance
# ZID_METRICS_PORT=9102                       # worker/relay/consumer scrape endpoint (private network only)
