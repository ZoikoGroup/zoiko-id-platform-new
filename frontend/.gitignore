# Frontend (pnpm + Turborepo + Next.js) — repo-wide rules are in /.gitignore.
# Committed on purpose: pnpm-lock.yaml, package.json files, next.config.*, tsconfig*.json.

# Dependencies
node_modules/
.pnpm-store/
.pnp
.pnp.*

# Next.js & build outputs
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# Turborepo & tooling caches
.turbo/
.eslintcache
.stylelintcache
storybook-static/

# Tests & coverage
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Package-manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Deployment platform metadata
.vercel/
