# Zoiko iD web app: environment template.
# Copy to .env.local for development. Every value is read on the Next.js server only: the browser
# talks to this app's own origin, and the BFF calls the cell API with tokens it keeps server-side.
# There are deliberately no NEXT_PUBLIC_* variables.

# --- Cell API ---------------------------------------------------------------------------------
# Cell API base URL, reached from the Next.js server, never from the browser.
ZID_CELL_API_URL=http://localhost:8000
# The cell's token issuer: must equal ZID_TOKEN_ISSUER in backend/.env. Defaults to ZID_CELL_API_URL.
ZID_TOKEN_ISSUER=http://localhost:8000

# --- This app ---------------------------------------------------------------------------------
# Public origin of this app; open the app at exactly this address. It must be listed in the cell's
# ZID_WEBAUTHN_ORIGINS, and its host must match ZID_WEBAUTHN_RP_ID (passkeys need a domain, so
# use localhost, not 127.0.0.1).
ZID_PUBLIC_ORIGIN=http://localhost:3000
# First-party OAuth client registered on the cell for this app (tools/scripts/bootstrap_local.py
# creates it locally).
ZID_OAUTH_CLIENT_ID=zoiko-web
# Redirect URI registered on that client. Optional; defaults to <ZID_PUBLIC_ORIGIN>/auth/callback.
# Locally it must be a loopback IP: the cell accepts only https or http://127.0.0.1 redirects.
ZID_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
# Display label for the environment: production | sandbox | test | development | local
ZID_ENVIRONMENT=local

# --- Optional ---------------------------------------------------------------------------------
# Enterprise sign-in buttons: connection_id=Label, comma separated (connections from
# POST /federation/integrations on the cell).
ZID_FEDERATION_CONNECTIONS=
# Session store (Valkey/Redis URL, e.g. redis://localhost:6379). Required in production, where
# instances share sessions; in-memory when unset in development.
ZID_VALKEY_URL=
# Production escape hatch: "true" allows in-memory sessions (single instance only). Leave unset.
ZID_ALLOW_MEMORY_SESSIONS=
# First-party device cookie (fraud and abuse signals). On by default; "off" stops setting it and stops sending x-zid-device.
ZID_DEVICE_COOKIE=
