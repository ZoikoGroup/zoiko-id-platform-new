# Copy to .env.local for development. Every value is read on the server only.

# Cell API (reached from the Next.js server, never from the browser).
ZID_CELL_API_URL=http://localhost:8000
# The cell's token issuer (ZID_TOKEN_ISSUER on the cell).
ZID_TOKEN_ISSUER=http://localhost:8000
# First-party OAuth client registered on the cell for this app (redirect URI: <ZID_PUBLIC_ORIGIN>/auth/callback).
ZID_OAUTH_CLIENT_ID=zoiko-web
# Public origin of this app. Must be listed in the cell's ZID_WEBAUTHN_ORIGINS.
ZID_PUBLIC_ORIGIN=http://localhost:3000
# Display label for the environment: production | sandbox | test | development | local
ZID_ENVIRONMENT=local
# Optional enterprise sign-in buttons: connection_id=Label, comma separated.
ZID_FEDERATION_CONNECTIONS=
# Session store. Required in production (multiple instances share sessions); in-memory when unset in development.
ZID_VALKEY_URL=
