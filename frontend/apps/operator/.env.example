# Zoiko iD Operator Console: environment template (copy to .env.local for development).
# A separate origin, OIDC client and session store from the customer web app (DEC-F4 §5, DEC-H1).
# Operators are principals of the dedicated operator tenant (cell: ZID_OPERATOR_TENANT_ID) and must
# sign in through this client (cell: ZID_OPERATOR_CLIENT_IDS). No NEXT_PUBLIC_* variables.

ZID_CELL_API_URL=http://localhost:8000
ZID_TOKEN_ISSUER=http://localhost:8000
# Must be in the cell's ZID_WEBAUTHN_ORIGINS (passkeys need a domain: use localhost).
ZID_PUBLIC_ORIGIN=http://localhost:3100
ZID_OAUTH_CLIENT_ID=zoiko-operator
ZID_OAUTH_REDIRECT_URI=http://127.0.0.1:3100/auth/callback
ZID_ENVIRONMENT=local
# Required in production (sessions shared by instances); in-memory in development when unset.
ZID_VALKEY_URL=
