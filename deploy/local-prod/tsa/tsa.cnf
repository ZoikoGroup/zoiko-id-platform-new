# `openssl ts -reply` configuration: what this authority signs with and promises (RFC 3161). Paths are inside the container's /data volume.
oid_section = new_oids

[ new_oids ]
zid_rehearsal_policy = 1.3.6.1.4.1.57264.99.1

[ tsa ]
default_tsa = tsa_config1

[ tsa_config1 ]
dir             = /data
serial          = $dir/tsaserial
crypto_device   = builtin
signer_cert     = $dir/tsa.crt
certs           = $dir/chain.pem
signer_key      = $dir/tsa.key
signer_digest   = sha256
default_policy  = zid_rehearsal_policy
other_policies  = zid_rehearsal_policy
digests         = sha256, sha384, sha512
accuracy        = secs:1
ordering        = yes
tsa_name        = yes
ess_cert_id_chain = no
ess_cert_id_alg = sha256
