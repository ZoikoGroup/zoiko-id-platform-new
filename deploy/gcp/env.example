# Copy to .env on the VM (chmod 600). Nothing here is a signing or encryption key: those stay in Cloud KMS, and API
# secrets (SMTP password, Stripe key, enterprise OIDC client secrets) go into OpenBao, not into this file.
ZID_DOMAIN=example.com               # id.<domain> console, api.<domain> API, global.<domain>; also the passkey RP id
ACME_EMAIL=ops@example.com
GCP_PROJECT=zoiko-prod
GCP_LOCATION=europe-west2
ZID_CELL_ID=eu-1
ZID_REGION=europe-west2
ZID_BACKEND_IMAGE=ghcr.io/zoikogroup/zoiko-id-platform@sha256:DIGEST   # the signed digest from the release workflow
ZID_WEB_IMAGE=ghcr.io/zoikogroup/zoiko-id-web@sha256:DIGEST   # signed digest from build-frontend-image.yml
# Operator console (profile `operator`): ZID_OPERATOR_IMAGE = ghcr.io/zoikogroup/zoiko-id-operator@sha256:DIGEST (build-frontend-image.yml)
# ZID_OPERATOR_IMAGE=
# OPERATOR_ALLOWED_CIDRS=203.0.113.0/24   # who may reach operator.<domain>
ZID_VALKEY_PASSWORD=                 # openssl rand -hex 24
# Cloud SQL (private IP). Three roles: owner (migrations only), runtime (API, row-level security), worker.
ZID_OWNER_CELL_DATABASE_URL=postgresql+asyncpg://zid_owner:PASSWORD@10.0.0.3:5432/zid_cell  # zid-secret-scan: allow (placeholder)
ZID_RUNTIME_CELL_DATABASE_URL=postgresql+asyncpg://zid_runtime:PASSWORD@10.0.0.3:5432/zid_cell  # zid-secret-scan: allow (placeholder)
ZID_WORKER_DATABASE_URL=postgresql+asyncpg://zid_worker:PASSWORD@10.0.0.3:5432/zid_cell  # zid-secret-scan: allow (placeholder)
# Email. The SMTP password is read from a file, never inline.
ZID_EMAIL_ENABLED=true
ZID_EMAIL_FROM=no-reply@example.com
ZID_SMTP_HOST=smtp.example.com
ZID_SMTP_USERNAME=
ZID_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# --- Operating modes chosen for this deployment (change records CR-035 and CR-036) -----------------------------------
# One operator account runs the platform: no access requests and no second approver for work that does not touch customer
# data. Every use is recorded as an event and an audit record. Production refuses this mode without the acknowledgement.
ZID_OPERATOR_MODE=direct
ZID_OPERATOR_DIRECT_ACK=accept-no-dual-control
# The company owner approves plan, pilot and activation steps alone (no second administrator). Same acknowledgement rule.
ZID_ONBOARDING_APPROVAL=owner
ZID_ONBOARDING_OWNER_ACK=accept-no-second-admin
# The operator tenant: generate a new uuid for a real deployment (python -c "import uuid;print(uuid.uuid4())")
ZID_OPERATOR_TENANT_ID=00000000-0000-4000-8000-0000000000e1
# Optional: uncomment what you use. Unset is different from empty, so leave unused ones out.
# ZID_STRIPE_SECRET_KEY_FILE=/run/secrets/stripe_key   # only if billing is on
# ZID_EVIDENCE_TSA_URL=                                # RFC 3161 timestamp authority for evidence checkpoints
# ZID_EVIDENCE_TSA_TRUST_FILE=                         # PEM of the TSA root certificates; required when the URL is set
# ZID_EVIDENCE_TSA_REVOCATION=if_available  # off | if_available | required (required: a missing CRL fails the timestamp)
# ZID_EVIDENCE_TSA_REQUIRED=false
# ZID_OPERATOR_CLIENT_IDS=["zoiko-operator"]
# First operator account (profile `operator-bootstrap`, run once): see backend/.env.example
# ZID_OPERATOR_BOOTSTRAP_PRINCIPAL_ID=                 # uuid, generated once: python -c "import uuid;print(uuid.uuid4())"
# ZID_OPERATOR_ORIGIN=https://operator.example.com
# ZID_OPERATOR_JURISDICTION=GB
# ZID_KAFKA_BOOTSTRAP=                                 # profile `events`: managed Kafka bootstrap servers
# ZID_RELAY_DATABASE_URL=                              # profile `events`: dedicated least-privilege relay role
# ZID_SPICEDB_URL=
# ZID_SPICEDB_KEY=
# --- Keys without a KMS (CR-060; standard assurance, see docs/runbooks/software-keys.md) ---
# ZID_KEY_PROVIDER=db                     # keys live in PostgreSQL, wrapped by a master key kept OUTSIDE the database
# ZID_KEY_MASTER_FILE=/zid/master_key     # python -m zid_platform.entrypoints.keys init-master --file ...; copy it offline
# ZID_KEY_PROVIDER_DB_ACK=accept-software-keys   # required in a deployed environment: the written risk acceptance

# --- Agent builds: look a digest up from an image name ---
# The console's Register build asks the registry what an image name points at, so nobody types a sha256. Only the hosts listed here are
# contacted (JSON list, exact host names, anonymous access only). A private registry is not reachable this way: let the build pipeline register
# the build instead (tools/scripts/register_build.py, see tools/ci/register-agent-build.yml).
# ZID_BUILD_REGISTRIES=["ghcr.io"]
# ZID_BUILD_IMAGES: the image repositories people register builds from (JSON list). The console offers them as a list to pick, then lists each
# one's versions to pick, so nobody types an image name. Repositories a build was already registered from are offered too. The host must be
# in ZID_BUILD_REGISTRIES, and the image public.
# ZID_BUILD_IMAGES=["ghcr.io/acme/invoice-bot"]
# Docker Hub needs BOTH of its hosts named (checked against the real registry): ["ghcr.io","registry-1.docker.io","auth.docker.io"]

# --- The global plane (tenant locator + discovery), served by the cell on the same port ---
# Discovery answers are signed. With ZID_KEY_PROVIDER=gcp-kms set ZID_DISCOVERY_KMS_KEY_ID (the signing key's resource name); with
# ZID_KEY_PROVIDER=db the key is kept in the database like the others. Without one, /v1/discovery answers 503.
# ZID_DISCOVERY_KMS_KEY_ID=
# ZID_LOCATOR_CELL_KEYS: each cell's pinned public publication key (JSON: cell id -> [public JWK]). A cell can publish a record only with its own
# key, so there is no other credential to steal. Without it nothing can be published here.
# ZID_LOCATOR_CELL_KEYS={"<cell id>":[{"kty":"EC","crv":"P-256","x":"...","y":"...","kid":"directory-<cell id>"}]}
# ZID_GLOBAL_LOCATOR_URL: where the worker publishes this cell's tenant records. The cell serves the global plane itself, so point it at the
# cell, never at a separate global service (there is none): http://cell:8000. Leave it unset to publish nothing.
# ZID_GLOBAL_LOCATOR_URL=http://cell:8000
# ZID_DIRECTORY_KMS_KEY_ID: the key this cell signs those records with (gcp-kms provider); with the db provider it is stored in the database.
# ZID_DIRECTORY_KMS_KEY_ID=
