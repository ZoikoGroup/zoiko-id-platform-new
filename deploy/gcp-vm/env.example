# Copy to .env on the APP VM (chmod 600). Nothing here is a signing or encryption key: those live in PostgreSQL wrapped by the
# master key FILE in ./secrets (never in this file). The SMTP password and the OpenBao token are files in ./secrets too.
ZID_DOMAIN=example.com               # id.<domain> console, api.<domain> API, global.<domain>; also the passkey relying-party id
ACME_EMAIL=ops@example.com
ZID_CELL_ID=eu-1                     # must exist in backend/config/cells/cells.yaml
ZID_REGION=europe-west2
ZID_BACKEND_IMAGE=ghcr.io/zoikogroup/zoiko-id-platform@sha256:DIGEST   # the signed digest from the release workflow
ZID_WEB_IMAGE=ghcr.io/zoikogroup/zoiko-id-web@sha256:DIGEST
ZID_OPERATOR_IMAGE=                  # the operator console image digest (profile `operator`); deploy.sh sets it from its third argument
ZID_OCR_IMAGE=                       # the ocr sidecar image digest (profile `idv`); deploy.sh sets it from its fourth argument
ZID_FACE_IMAGE=                      # the face sidecar image digest (profile `idv`); deploy.sh sets it from its fifth argument
OPERATOR_ALLOWED_CIDRS=127.0.0.1/32  # who may reach operator.<domain> (comma separated CIDRs). The default lets nobody in from outside; set your office or VPN range
ZID_VALKEY_PASSWORD=                 # openssl rand -hex 24

# --- Keys in the database (CR-060): the Security Lead's written acceptance of software keys. Leave empty until it is signed;
#     the stack refuses to start without exactly this value.
ZID_KEY_PROVIDER_DB_ACK=

# --- Agents and mandates (CR-091 to CR-146) -----------------------------------------------------------------------------------
ZID_CELL_UUID=                       # REQUIRED. This cell's id in the ledger writer fence. Make it once (uuidgen | tr A-Z a-z), keep it forever: mandates record it
ZID_AGENT_GOVERNANCE=enforce         # enforce | shadow. enforce refuses for real; the emergency stop applies in both
ZID_ACCESS_READINESS_ENABLED=true    # the access readiness agent (DAARA); it runs only in this cell (ZID_CELL_ID)
ZID_API_AGENTS=on                    # API-only agents (no image, no attestor). Shipped OFF in production (CR-144): this line is the named decision. off = disabled

# --- Where the other VMs are (private addresses) -----------------------------------------------------------------------------
ZID_DB_HOST=10.0.0.3                 # the database VM
ZID_SERVICES_HOST=10.0.0.4           # the services VM (OpenBao 8200, Kafka 9092, SpiceDB 8443)

# --- Database: three roles on the database VM (owner migrates, runtime has row-level security, worker bypasses it) ----------
# ssl=require makes the app refuse a plaintext connection; the database VM's certificate is checked by setup (README step 3).
ZID_OWNER_CELL_DATABASE_URL=postgresql+asyncpg://zid_owner:PASSWORD@10.0.0.3:5432/zid_cell?ssl=require  # zid-secret-scan: allow (placeholder)
ZID_RUNTIME_CELL_DATABASE_URL=postgresql+asyncpg://zid_runtime:PASSWORD@10.0.0.3:5432/zid_cell?ssl=require  # zid-secret-scan: allow (placeholder)
ZID_WORKER_DATABASE_URL=postgresql+asyncpg://zid_worker:PASSWORD@10.0.0.3:5432/zid_cell?ssl=require  # zid-secret-scan: allow (placeholder)
ZID_RELAY_DATABASE_URL=postgresql+asyncpg://zid_relay:PASSWORD@10.0.0.3:5432/zid_cell?ssl=require  # zid-secret-scan: allow (placeholder)

# --- Event platform (profile `events`) ---------------------------------------------------------------------------------------
ZID_SPICEDB_PRESHARED_KEY=           # openssl rand -hex 24 (the same value on the services VM)

# --- Services VM only (docker-compose.services.yml) --------------------------------------------------------------------------
ZID_OPENBAO_DB_PASSWORD=             # the `openbao` role on the database VM
ZID_SPICEDB_DB_PASSWORD=             # the `spicedb` role on the database VM
# ZID_SERVICES_BIND=10.0.0.4         # publish those ports on the private address only (default: all interfaces; the firewall must then limit them)

# --- Email: a real SMTP relay with TLS. The password is the file ./secrets/smtp_password -----------------------------------------
ZID_EMAIL_FROM=no-reply@example.com
ZID_SMTP_HOST=smtp.example.com
ZID_SMTP_USERNAME=

# --- Operating modes chosen for this deployment (CR-035, CR-036). Production refuses each without its acknowledgement ----------
ZID_OPERATOR_MODE=direct
ZID_OPERATOR_DIRECT_ACK=accept-no-dual-control
ZID_ONBOARDING_APPROVAL=owner
ZID_ONBOARDING_OWNER_ACK=accept-no-second-admin
ZID_OPERATOR_TENANT_ID=00000000-0000-4000-8000-0000000000e1   # generate a new uuid for a real deployment

# --- Optional: uncomment what you use. Unset is different from empty, so leave unused ones out --------------------------------
# ZID_REGISTRATION_TENANT_ID=          # printed by `python -m zid_platform.entrypoints.seed_registration_tenant --apply` (README step 7)
# ZID_PROOF_SCANNER_ADDRESS=           # clamd host:port; without it company proof uploads are refused
# ZID_STRIPE_SECRET_KEY_FILE=/run/secrets/stripe_key   # only if billing is on
# ZID_EVIDENCE_TSA_URL=                # an RFC 3161 timestamp authority: strongly recommended with software keys (CR-060)
# ZID_EVIDENCE_TSA_TRUST_FILE=/run/secrets/tsa_roots.pem
# ZID_EVIDENCE_TSA_REVOCATION=if_available
# ZID_COMMERCIAL_ENFORCEMENT=shadow    # shadow | enforce, once Commercial has signed the price book
# --- Evidence integrity (CR-060 addendum) ---
# ZID_EVIDENCE_TSA_REQUIRED=false             # true: nothing is sealed without an external timestamp (entries stay visibly unsealed)
# ZID_EVIDENCE_VERIFY_INTERVAL=21600          # seconds between scheduled re-verifications of each evidence partition (0 = off)
# ZID_EVIDENCE_VERIFY_BATCH=2                 # partitions checked per worker pass
# ZID_EVIDENCE_TSA_WAIVER=accept-no-external-timestamps   # only to run software keys WITHOUT a timestamp authority: the owners' written acceptance
# ZID_METRICS_PORT=9102                       # worker/relay/consumer scrape endpoint (private network only)

# --- Workload identity and agents (README section 9; profile `workload-identity`). Leave all of it out to run without ---------
# ZID_SPIFFE_TRUST_DOMAIN=eu-1.production.id.zoiko   # <cell>.<environment>.id.zoiko: governed, never invented
# ZID_SPIFFE_BUNDLE_FILES={"eu-1.production.id.zoiko": "/run/secrets/spire_bundle.pem"}
# ZID_MESH_TRUSTED_PROXIES=["172.30.0.250"]          # the workload listener's fixed address: the cell trusts a forwarded certificate from it only
# ZID_MESH_PROXY_SECRET_FILE=/run/secrets/mesh_proxy_secret   # the secret the workload listener adds; required whenever ZID_MESH_TRUSTED_PROXIES is set (workload-identity.sh proxy-secret)
# ZID_ATTESTOR_KEYS_FILE=/run/secrets/attestor_keys.json   # the attestor's PUBLIC key (workload-identity.sh attestor-init)
# ZID_SPIRE_JOIN_TOKEN=                              # first start of spire-agent only; remove once it has joined
# ZID_DOCKER_GID=999                                 # getent group docker: the attestor reads the engine socket through this group
# ZID_WORKLOAD_BIND=10.0.0.5                         # the app VM's private address: where :9443 is published (default 127.0.0.1)
# ZID_SPIRE_DATA_DIR=/var/lib/zid/spire-server       # services VM
# ZID_AGENT_BUILDS=auto                              # auto (default): a blueprint release and a workload binding must run an APPROVED build (Agents & tools > Builds)
#                                                    #   everywhere except local, test and dev. enforce: always. off: never, refused in a deployed environment.

# --- Agent builds: look a digest up from an image name ---
# The console's Register build asks the registry what an image name points at, so nobody types a sha256. Only the hosts listed here are
# contacted (JSON list, exact host names, anonymous access only). A private registry is not reachable this way: let the build pipeline register
# the build instead (tools/scripts/register_build.py, see tools/ci/register-agent-build.yml).
# ZID_BUILD_REGISTRIES=["ghcr.io"]
# ZID_BUILD_IMAGES: the image repositories people register builds from (JSON list). The console offers them as a list to pick, then lists each
# one's versions to pick, so nobody types an image name. Repositories a build was already registered from are offered too. The host must be
# in ZID_BUILD_REGISTRIES, and the image public.
# ZID_BUILD_IMAGES=["ghcr.io/acme/invoice-bot"]
# Docker Hub needs BOTH of its hosts named (checked against the real registry): ["ghcr.io","registry-1.docker.io","auth.docker.io"]

# --- The global plane (tenant locator + discovery), served by the cell on the same port ---
# Discovery answers are signed. With ZID_KEY_PROVIDER=gcp-kms set ZID_DISCOVERY_KMS_KEY_ID (the signing key's resource name); with
# ZID_KEY_PROVIDER=db the key is kept in the database like the others. Without one, /v1/discovery answers 503.
# ZID_DISCOVERY_KMS_KEY_ID=
# ZID_LOCATOR_CELL_KEYS: each cell's pinned public publication key (JSON: cell id -> [public JWK]). A cell can publish a record only with its own
# key, so there is no other credential to steal. Without it nothing can be published here.
# ZID_LOCATOR_CELL_KEYS={"<cell id>":[{"kty":"EC","crv":"P-256","x":"...","y":"...","kid":"directory-<cell id>"}]}
# ZID_GLOBAL_LOCATOR_URL: where the worker publishes this cell's tenant records. The cell serves the global plane itself, so point it at the
# cell, never at a separate global service (there is none): http://cell:8000. Leave it unset to publish nothing.
# ZID_GLOBAL_LOCATOR_URL=http://cell:8000
# ZID_DIRECTORY_KMS_KEY_ID: the key this cell signs those records with (gcp-kms provider); with the db provider it is stored in the database.
# ZID_DIRECTORY_KMS_KEY_ID=


# Agents (CR-091 to CR-094, CR-142, CR-144). Every one of these is off or conservative until a named decision turns it on.
# ZID_AGENT_GOVERNANCE=enforce            off | shadow (default) | enforce: whether agent governance denies for real
# ZID_ACCESS_READINESS_ENABLED=false      the access readiness agent (ZID-AG-WF-001); on only with the regions below
# ZID_ACCESS_READINESS_REGIONS=["eu-1"]   the cells it may run in (a JSON list of cell ids); a cell not listed says "not available in this region"
# ZID_AGENT_RUN_ROLE=zid_runtime          the worker runs each company's queued agent run AS this role, so row-level security applies to it (grant in db/01_roles.sql)
# ZID_API_AGENTS=auto                     API-based agents: auto = OFF in production; set on only after the security owner signs (docs/specs/decisions/agent-owner-decision-pack.md section C)

# --- Identity-check sidecars (profile `idv`). Same services as the local stack; images built and signed by build-sidecar-image.yml (set ZID_OCR_IMAGE and ZID_FACE_IMAGE above) ----
# ZID_OCR_URL=http://ocr:8090                  # reads the printed lines of a document; the company certificate check needs it
# ZID_FACE_URL=http://face:8091                # the face-match lab engine only (no liveness, never an approval)
# ZID_PROOF_SCANNER_ADDRESS=clamd:3310         # the clamd service above; set it instead of the line further up when this profile runs

# --- Identity verification for every country (docs/specs/identity-and-company-verification-design.md, section 6). OFF until the owners accept it in writing ------------------
# The built-in global policy (backend/config/idv/global-policy.yaml) serves any country that has no policy of its own, so nobody has to release a country first. Set this ONLY after Privacy,
# Legal and Compliance accepted EVERY value in that file in writing (photograph retention, how long an approval counts, the face-match line, the expired-document rule). Without it a country with
# no policy of its own is refused, as before. The face route also needs its own acknowledgement below (no liveness test, no check that the document is genuine).
# ZID_IDV_GLOBAL_POLICY_ACK=accept-global-idv-policy
# ZID_IDV_FACE_ROUTE_ACK=accept-no-liveness-no-evaluation
