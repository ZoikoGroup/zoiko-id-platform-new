{
	email {$ACME_EMAIL}
}

# A workload's identity arrives only through the workload listener (Caddyfile.workload), which sets this header itself from a verified
# client certificate. Every public site drops it, so a caller on the internet cannot present a certificate it only copied.
(no_forwarded_cert) {
	request_header -X-Forwarded-Client-Cert
	request_header -X-Zid-Proxy-Auth
}

# Console (passkeys need this exact origin: https://id.<domain>)
id.{$ZID_DOMAIN} {
	import no_forwarded_cert
	encode zstd gzip
	reverse_proxy web:3000
}

# Cell API: OAuth/OIDC, passkeys, AuthZEN, the protected APIs
api.{$ZID_DOMAIN} {
	import no_forwarded_cert
	encode zstd gzip
	header Strict-Transport-Security "max-age=63072000; includeSubDomains"
	# the attestor calls the cell directly; its statements are never accepted from the internet
	@attestation path /v1/machine/attestations:verify
	handle @attestation {
		respond 404
	}
	handle {
		reverse_proxy cell:8000
	}
}

# Global plane: tenant locator and discovery (no personal data)
global.{$ZID_DOMAIN} {
	import no_forwarded_cert
	encode zstd gzip
	reverse_proxy cell:8000
}

# Public Trust Center (ZID-CP-WF12): read-only pages and the security.txt file, on their own host, no sign-in. Only these paths reach the web app from the internet on this host;
# everything else is a plain 404 so the console is never served here. The data comes from the cell's /public/* routes, which the web app reads server-side.
trust.{$ZID_DOMAIN} {
	import no_forwarded_cert
	encode zstd gzip
	header Strict-Transport-Security "max-age=63072000; includeSubDomains"
	@public path /trust /trust/* /.well-known/security.txt /_next/* /favicon.ico
	handle @public {
		reverse_proxy web:3000
	}
	handle {
		respond 404
	}
}

# Operator Console (only when the `operator` compose profile is running). Restrict by source IP or put IAP in front.
operator.{$ZID_DOMAIN} {
	import no_forwarded_cert
	encode zstd gzip
	@allowed remote_ip {$OPERATOR_ALLOWED_CIDRS:127.0.0.1/32}
	handle @allowed {
		reverse_proxy operator:3000
	}
	respond 403
}

